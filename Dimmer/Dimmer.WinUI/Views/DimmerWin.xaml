<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Dimmer.WinUI.Views.DimmerWin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:converters="using:Dimmer.WinUI.Utils.Converters"
    xmlns:customViews="using:Dimmer.WinUI.Views.CustomViews.WinuiViews"
    xmlns:d="http://schemas.microsoft.com/expression/blBottom/2008"
    xmlns:devWin="using:DevWinUI"
    xmlns:local="using:Dimmer.WinUI.Views"
    xmlns:localViews="using:Dimmer.WinUI.Views.CustomViews.WinuiViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Dimmer.Data.ModelView;assembly=Dimmer"
    xmlns:stateTriggers="using:Dimmer.WinUI.Utils.StateTriggers"
    Title="DimmerWin"
    Activated="Window_Activated"
    Closed="DimmerWindowClosed"
    SizeChanged="Window_SizeChanged"
    mc:Ignorable="d">

    <NavigationView
        x:Name="nvSample"
        x:FieldModifier="Public"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        IsTapEnabled="True"
        PaneClosing="NvSample_PaneClosing"
        PaneOpening="NvSample_PaneOpening"
        SelectionChanged="NvSample_SelectionChanged"
        Tapped="NvSample_Tapped">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="SongsBtn"
                Content="Songs"
                Tag="SongsTag"
                Tapped="SongsBtn_Tapped">
                <NavigationViewItem.Icon>
                    <FontIcon FontSize="30" Glyph="&#xE8D6;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="ArtistsBtn"
                Content="Artists"
                Tag="ArtistsTag"
                Tapped="ArtistsBtn_Tapped">

                <NavigationViewItem.Icon>
                    <FontIcon FontSize="30" Glyph="&#xE720;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="AlbumsBtn"
                Content="Albums"
                Tag="AlbumsTag"
                Tapped="AlbumsBtn_Tapped">
                <NavigationViewItem.Icon>
                    <FontIcon FontSize="30" Glyph="&#xE93C;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="PlaylistsBtn"
                Content="Playlists"
                Tag="PlaylistsTag"
                Tapped="PlaylistsBtn_Tapped">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEA65;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>



            <NavigationViewItem
                x:Name="DimsStatsBtn"
                Content="Dimner Stats"
                Tag="DimsStats"
                Tapped="DimsStatsBtn_Tapped">
                <NavigationViewItem.Icon>
                    <FontIcon FontSize="30" Glyph="&#xEB05;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="DimmerUtilities"
                Content="Utilities"
                Tag="UtilitiesTag"
                Tapped="DimmerUtilities_Tapped">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEC7A;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="DimmerCloud"
                Content="Dimmer Cloud"
                Tag="DimmerCloudTag"
                Tapped="DimmerCloud_Tapped">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEA91;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>


        </NavigationView.MenuItems>

        <NavigationView.PaneFooter>
            <StackPanel
                x:Name="BottomCurrentPlayingSongPanel"
                Margin="5"
                HorizontalAlignment="Stretch"
                Visibility="{x:Bind MyViewModel.BottomCurrentPlayingSongPanelVisibility, Mode=OneWay}">

                <StackPanel Margin="5">
                    <Grid
                        Grid.Column="0"
                        MaxWidth="150"
                        MaxHeight="150"
                        HorizontalAlignment="Center">
                        <devWin:GooeyButton
                            x:Name="CurrentPlayingSongGooeyButton"
                            Background="#1e1e1e"
                            Canvas.ZIndex="1"
                            ExitDisplayModeOnAccessKeyInvoked="True"
                            ItemInvoked="CurrentPlayingSongGooeyButton_ItemInvoked"
                            Loaded="CurrentPlayingSongGooeyButton_Loaded"
                            Opacity="0.3">
                            <devWin:GooeyButton.Items>
                                <devWin:GooeyButtonItem
                                    x:Name="ScrollToCurrentSongGooeyBtnItem"
                                    Width="70"
                                    Height="70"
                                    CornerRadius="15">
                                    <devWin:GooeyButtonItem.Content>
                                        <SymbolIcon x:Name="ViewSymbol" Symbol="View" />
                                    </devWin:GooeyButtonItem.Content>
                                </devWin:GooeyButtonItem>

                                <devWin:GooeyButtonItem
                                    x:Name="FavCurrentSongGooeyBtnItem"
                                    Width="70"
                                    Height="70"
                                    CornerRadius="15">
                                    <devWin:GooeyButtonItem.Content>
                                        <FontIcon x:Name="FavCurrentSong" Glyph="&#xEB51;" />
                                    </devWin:GooeyButtonItem.Content>
                                </devWin:GooeyButtonItem>

                                <devWin:GooeyButtonItem
                                    x:Name="OpenNowPlayingView"
                                    Width="70"
                                    Height="70"
                                    CornerRadius="15">
                                    <devWin:GooeyButtonItem.Content>
                                        <FontIcon x:Name="OpenNowPlayingViewFontIcon" Glyph="&#xF71C;" />
                                    </devWin:GooeyButtonItem.Content>
                                </devWin:GooeyButtonItem>

                            </devWin:GooeyButton.Items>
                        </devWin:GooeyButton>
                        <devWin:ImageEx
                            x:Name="CurrentPlayingSongImage"
                            VerticalAlignment="Top"
                            Canvas.ZIndex="0"
                            CornerRadius="20"
                            Loaded="CurrentPlayingSongImage_Loaded" />
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Background="Transparent"
                        Loaded="StackPanel_Loaded"
                        Spacing="5">

                        <devWin:AutoScrollView IsPlaying="True">
                            <TextBlock
                                x:Name="CurrentPlayingTitleTB"
                                FontSize="22"
                                TextTrimming="CharacterEllipsis" />
                        </devWin:AutoScrollView>



                        <devWin:AutoScrollView IsPlaying="True">
                            <TextBlock
                                x:Name="CurrentPlayingArtistsTB"
                                FontSize="18"
                                TextTrimming="CharacterEllipsis" />
                        </devWin:AutoScrollView>

                        <devWin:AutoScrollView IsPlaying="True">
                            <TextBlock
                                x:Name="CurrentPlayingAlbumTB"
                                FontSize="16"
                                TextTrimming="CharacterEllipsis" />
                        </devWin:AutoScrollView>


                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ToggleButton
                                    x:Name="PlayPauseToggleBtn"
                                    Height="40"
                                    Command="{x:Bind MyViewModel.PlayPauseToggleCommand}"
                                    IsChecked="{x:Bind MyViewModel.IsDimmerPlaying, Mode=OneWay}"
                                    Loaded="PlayPauseToggleBtn_Loaded" />
                                <devWin:BubbleButton
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="❤️"
                                    FontSize="40"
                                    Visibility="{x:Bind MyViewModel.CurrentPlayingSongView.IsFavorite, Mode=OneWay}" />
                            </StackPanel>


                        </Grid>
                    </StackPanel>
                </StackPanel>


                <NavigationViewItem
                    x:Name="ScrollToCurrentSong"
                    Content="ScrollToSong"
                    Tag="ScrollToSong"
                    Tapped="ScrollToCurrentSong_Tapped">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE890;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="DimmerLiveBtn"
                    Content="Dimmer Live"
                    Tag="DimmerLiveTag"
                    Tapped="DimmerLiveBtn_Tapped">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE93E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="SettingsBtn"
                    Content="Settings"
                    Tag="SettingsTag"
                    Tapped="SettingsBtn_Tapped">
                    <NavigationViewItem.Icon>
                        <FontIcon FontSize="30" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </StackPanel>
        </NavigationView.PaneFooter>
        <Grid x:Name="MainGrid" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />

            </Grid.RowDefinitions>




            <Grid
                x:Name="TopRowGrid"
                Grid.Row="0"
                ColumnSpacing="5">
                <Grid.ColumnDefinitions>


                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>


                <StackPanel Margin="10" Spacing="5">
                    <StackPanel
                        Margin="10"
                        Orientation="Horizontal"
                        Spacing="5">
                        <devWin:TextBox
                            x:Name="SearchBoxEdit"
                            MinWidth="350"
                            Header="Search With TQL."
                            PlaceholderText=""
                            TextChanged="SearchBoxEdit_TextChanged">
                            <devWin:TextBox.Content>
                                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                    <Button
                                        x:Name="SaveTQL"
                                        HorizontalAlignment="Left"
                                        HorizontalContentAlignment="Left"
                                        Click="SaveTQL_Click">
                                        <FontIcon Glyph="&#xE74E;" />
                                    </Button>
                                </StackPanel>
                            </devWin:TextBox.Content>
                        </devWin:TextBox>
                        <TextBlock
                            x:Name="SearchResultErrorText"
                            FontSize="16"
                            Loaded="SearchResultErrorText_Loaded" />
                    </StackPanel>


                    <StackPanel
                        x:Name="QuickTQLCommandsStackPanel"
                        Orientation="Horizontal"
                        Spacing="8">
                        <ToggleButton
                            x:Name="ShowNowPlayingQueue"
                            Checked="ShowNowPlayingQueue_Checked"
                            Content="Now Playing Queue"
                            Unchecked="ShowNowPlayingQueue_Unchecked" />
                        <Button
                            x:Name="ApplyShuffleToTql"
                            Click="ApplyShuffleToTql_Click"
                            Content="Shuffle" />
                        <Button
                            x:Name="SaveQueueToPlaylist"
                            Click="SaveQueueToPlaylist_Click"
                            ToolTipService.ToolTip="Save To Playlist">
                            <FontIcon Glyph="&#xE74E;" />
                        </Button>
                    </StackPanel>
                    <devWin:FlipCards
                        x:Name="SongsCountFlipCard"
                        HorizontalAlignment="Left"
                        Source="Value"
                        Value="{x:Bind MyViewModel.MySongsTableViewItemsCount, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    devWin:Growl.GrowlEnterTransition="EntranceThemeTransition"
                    devWin:Growl.GrowlExitTransition="EntranceThemeTransition"
                    devWin:Growl.GrowlParent="True"
                    devWin:Growl.Token="BottomCurrentPlayingSongPanel" />
            </Grid>

            <Frame
                x:Name="ContentFrame"
                Grid.Row="1"
                x:FieldModifier="Public"
                Navigated="ContentFrame_Navigated" />



        </Grid>

    </NavigationView>
</Window>
