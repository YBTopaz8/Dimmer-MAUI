<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dimmer.WinUI.Views.WinuiPages.Artist.AllArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Dimmer.Utilities.TypeConverters;assembly=Dimmer"
    xmlns:convertersWinUI="using:Dimmer.WinUI.Utils.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blBottom/2008"
    xmlns:devWin="using:DevWinUI"
    xmlns:dgView="using:WinUI.TableView"
    xmlns:dimmSearch="clr-namespace:Dimmer.Data.ModelView.DimmerSearch;assembly=Dimmer"
    xmlns:lang="clr-namespace:Dimmer.Resources.Localization;assembly=Dimmer"
    xmlns:local="using:Dimmer.WinUI.Views.CustomViews.WinuiViews"
    xmlns:localArtist="using:Dimmer.WinUI.Views.WinuiPages.Artist"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:models="clr-namespace:Dimmer.Data.ModelView;assembly=Dimmer"
    xmlns:modelsDb="clr-namespace:Dimmer.Data.Models;assembly=Dimmer"
    xmlns:modeltwo="clr-namespace:Dimmer.WinUI.Utils.Models"
    xmlns:queryBuilder="queries"
    xmlns:tql="clr-namespace:Dimmer.DimmerSearch.TQL;assembly=Dimmer"
    xmlns:vm="clr-namespace:Dimmer.WinUI.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:BaseViewModelWin}"
    mc:Ignorable="d">


    <Page.Resources>
        <Style x:Key="HeaderSortButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  Table Row Button Style (Provides the smooth Windows 11 hover & press states)  -->
        <Style x:Key="ProTableRowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <!--  Row Quick Action Menu  -->
        <MenuFlyout x:Key="RowQuickFlyout">
            <MenuFlyoutItem
                Click="ContextMenuPlay_Click"
                Icon="Play"
                Text="Play" />
            <MenuFlyoutItem
                Click="ContextMenuQueue_Click"
                Icon="List"
                Text="Add to Queue" />
            <MenuFlyoutItem
                Click="ContextMenuPlaylist_Click"
                Icon="Add"
                Text="Add to Playlist" />
        </MenuFlyout>
    </Page.Resources>
    <Grid Margin="16" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <!--  Left Panel Fixed Width  -->
            <ColumnDefinition Width="320" />
            <!--  Right Panel takes the rest  -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ================= LEFT PANEL: ARTISTS LIST =================  -->
        <Grid Grid.Column="0" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                FontWeight="Bold"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="Artists" />

            <!--  The Search Bar  -->
            <AutoSuggestBox
                x:Name="FilterArtistName"
                Grid.Row="1"
                Loaded="FilterArtistName_Loaded"
                PlaceholderText="Search artists..."
                SuggestionChosen="FilterArtistName_SuggestionChosen"
                TextChanged="FilterArtistName_TextChanged" />

            <!--  The Artists Table View  -->
            <dgView:TableView
                x:Name="AllArtistsTableView"
                Grid.Row="2"
                AutoGenerateColumns="False"
                Background="Transparent"
                IsReadOnly="True"
                ItemsSource="{x:Bind MyViewModel.ArtistsCollection, Mode=OneWay}"
                RowHeight="60"
                Tapped="AllArtistsTableView_Tapped">

                <dgView:TableView.Columns>
                    <dgView:TableViewTemplateColumn Width="*" Header="Name">
                        <dgView:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Padding="8,0"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <PersonPicture
                                        Width="36"
                                        Height="36"
                                        DisplayName="{Binding Name}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </dgView:TableViewTemplateColumn.CellTemplate>
                    </dgView:TableViewTemplateColumn>
                </dgView:TableView.Columns>
            </dgView:TableView>
        </Grid>

        <!--  ================= RIGHT PANEL: ARTIST DETAILS =================  -->
        <Border
            Grid.Column="1"
            Padding="24,24,8,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">

            <Grid RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Header Actions  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        FontWeight="Bold"
                        Style="{ThemeResource HeaderTextBlockStyle}"
                        Text="{x:Bind MyViewModel.SelectedArtist.Name, Mode=OneWay}"
                        TextWrapping="WrapWholeWords" />

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            Padding="16,8"
                            CornerRadius="20"
                            Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE768;" />
                                <TextBlock FontWeight="SemiBold" Text="Play All" />
                            </StackPanel>
                        </Button>
                        <Button CornerRadius="20" ToolTipService.ToolTip="Add To Queue">
                            <FontIcon FontSize="14" Glyph="&#xE8D8;" />
                        </Button>
                        <Button CornerRadius="20" ToolTipService.ToolTip="Add To Playlist">
                            <FontIcon FontSize="14" Glyph="&#xE109;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  Scrollable Albums Area  -->
                <ScrollViewer
                    Grid.Row="1"
                    Padding="0,0,16,24"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsRepeater ItemsSource="{x:Bind MyViewModel.SelectedArtist.AlbumsByArtist, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <!--  ALBUM CARD  -->
                                <Border
                                    Margin="0,0,0,24"
                                    Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Album Cover  -->
                                        <StackPanel Grid.Column="0">

                                            <devWin:ImageEx
                                                Width="160"
                                                Height="160"
                                                VerticalAlignment="Top"
                                                CornerRadius="8"
                                                Source="{Binding ImagePath, Mode=OneWay, Converter={StaticResource StringToImageConverter}}"
                                                Stretch="UniformToFill" />
                                            <TextBlock Text="{Binding Artists[0].Name}" />
                                        </StackPanel>
                                        <!--  Album Details & Songs  -->
                                        <Grid Grid.Column="1" RowSpacing="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!--  Album Title & Stats  -->
                                            <StackPanel Grid.Row="0">
                                                <TextBlock
                                                    FontSize="19"
                                                    FontWeight="Bold"
                                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                                    Text="{Binding Name, Mode=OneWay}" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding SongsInAlbum.Count, Mode=OneWay}" />
                                                    <Run Text="Tracks" />
                                                </TextBlock>

                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding Artists.Count, Mode=OneWay}" />
                                                    <Run Text="Artists" />
                                                </TextBlock>
                                            </StackPanel>

                                            <!--  Songs Table (Restricted Height to avoid Layout Cycle)  -->
                                            <!--
                                            <ListView ItemsSource="{Binding SongsInAlbum,Mode=OneWay}">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>-->
                                            <dgView:TableView
                                                Grid.Row="1"
                                                MaxHeight="350"
                                                AutoGenerateColumns="False"
                                                Background="Transparent"
                                                HeadersVisibility="All"
                                                IsReadOnly="True"
                                                ItemsSource="{Binding SongsInAlbum, Mode=OneWay}"
                                                RowHeight="40"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                ScrollViewer.VerticalScrollMode="Auto">
                                                <dgView:TableView.Columns>
                                                    <dgView:TableViewTemplateColumn Width="auto" Header="s">
                                                        <dgView:TableViewTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel
                                                                    Width="90"
                                                                    VerticalAlignment="Center"
                                                                    Opacity="{Binding Converter={StaticResource SongHighlightConverter}, ConverterParameter='Opacity'}"
                                                                    Orientation="Horizontal"
                                                                    Spacing="4">
                                                                    <Button
                                                                        Padding="8"
                                                                        Background="Transparent"
                                                                        BorderThickness="0">
                                                                        <FontIcon FontSize="12" Glyph="&#xE768;" />
                                                                    </Button>
                                                                    <Button
                                                                        Padding="8"
                                                                        Background="Transparent"
                                                                        BorderThickness="0">
                                                                        <FontIcon FontSize="12" Glyph="&#xE109;" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </dgView:TableViewTemplateColumn.CellTemplate>
                                                    </dgView:TableViewTemplateColumn>
                                                    <dgView:TableViewTemplateColumn Width="50" Header="#">
                                                        <dgView:TableViewTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Opacity="{Binding Converter={StaticResource SongHighlightConverter}, ConverterParameter='Opacity'}"
                                                                    Text="{Binding TrackNumber}" />
                                                            </DataTemplate>
                                                        </dgView:TableViewTemplateColumn.CellTemplate>
                                                    </dgView:TableViewTemplateColumn>

                                                    <dgView:TableViewTemplateColumn Width="*" Header="Title">
                                                        <dgView:TableViewTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel
                                                                    VerticalAlignment="Center"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                                    <TextBlock
                                                                        FontWeight="{Binding Converter={StaticResource SongHighlightConverter}, ConverterParameter='FontWeight'}"
                                                                        Opacity="{Binding Converter={StaticResource SongHighlightConverter}, ConverterParameter='Opacity'}"
                                                                        Text="{Binding Title}"
                                                                        TextTrimming="CharacterEllipsis" />


                                                                    <Border
                                                                        Padding="4,1"
                                                                        Background="{ThemeResource SystemAccentColor}"
                                                                        CornerRadius="4"
                                                                        Visibility="{Binding IsBySelectedArtist, Mode=OneWay}">
                                                                        <TextBlock
                                                                            FontSize="9"
                                                                            FontWeight="Bold"
                                                                            Foreground="White"
                                                                            Text="ARTIST TRACK" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </dgView:TableViewTemplateColumn.CellTemplate>
                                                    </dgView:TableViewTemplateColumn>

                                                    <!--  Time  -->
                                                    <dgView:TableViewTemplateColumn Width="80" Header="Time">
                                                        <dgView:TableViewTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Opacity="{Binding Converter={StaticResource SongHighlightConverter}, ConverterParameter='Opacity'}"
                                                                    Text="{Binding DurationFormatted}" />
                                                            </DataTemplate>
                                                        </dgView:TableViewTemplateColumn.CellTemplate>
                                                    </dgView:TableViewTemplateColumn>

                                                </dgView:TableView.Columns>

                                                <dgView:TableView.FooterTemplate>
                                                    <DataTemplate>
                                                        <StackPanel
                                                            Margin="0,4,8,0"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal">
                                                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                                <Run Text="{Binding SongsInAlbum.Count, Mode=OneWay}" />
                                                                <Run Text="Total Tracks" />
                                                            </TextBlock>

                                                        </StackPanel>
                                                    </DataTemplate>

                                                </dgView:TableView.FooterTemplate>
                                            </dgView:TableView>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

</Page>