<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dimmer.WinUI.Views.WinuiPages.Artist.ArtistDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:devWin="using:DevWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Dimmer.Data.ModelView;assembly=Dimmer"
    xmlns:vm="clr-namespace:Dimmer.WinUI.ViewModel"
    d:DataContext="{d:DesignInstance Type=vm:BaseViewModelWin}"
    mc:Ignorable="d">



    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="400" />
                <!--  Hero Header  -->
                <RowDefinition Height="*" />
                <!--  Content  -->
            </Grid.RowDefinitions>

            <!--  ==========================================================  -->
            <!--  1. HERO HEADER: Edge-to-Edge with Smooth Gradient Fade  -->
            <!--  ==========================================================  -->
            <Grid Grid.Row="0">
                <devWin:ImageEx
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Source="{x:Bind MyViewModel.SelectedArtist.ImagePath, Mode=OneWay}"
                    Stretch="UniformToFill" />

                <!--  Rich multi-stop gradient to blend seamlessly into the page background  -->
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0.0" Color="#44000000" />
                            <GradientStop Offset="0.5" Color="#AA000000" />
                            <GradientStop Offset="0.9" Color="{ThemeResource SolidBackgroundFillColorBase}" />
                            <GradientStop Offset="1.0" Color="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
                        </LinearGradientBrush>
                    </Grid.Background>
                </Grid>

                <StackPanel
                    Padding="48,0,48,32"
                    VerticalAlignment="Bottom"
                    Spacing="16">

                    <!--  Verified & Rank Badge  -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            Padding="6,2"
                            Background="{ThemeResource SystemAccentColor}"
                            CornerRadius="4">
                            <TextBlock
                                CharacterSpacing="50"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="VERIFIED ARTIST" />
                        </Border>

                        <Border
                            Padding="6,2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="RANK #" /><Run Text="{x:Bind MyViewModel.SelectedArtist.OverallRank, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!--  Artist Name  -->
                    <TextBlock
                        Margin="0,-10,0,0"
                        FontSize="72"
                        FontWeight="Black"
                        Text="{x:Bind MyViewModel.SelectedArtist.Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <!--  Quick Play Stats  -->
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind MyViewModel.SelectedArtist.TotalCompletedPlays, Mode=OneWay}" /> <Run Text="Total Plays  • " />
                        <Run Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind MyViewModel.SelectedArtist.TotalSongsByArtist, Mode=OneWay}" /> <Run Text="Songs  •  Discovered" />
                        <Run Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{x:Bind MyViewModel.SelectedArtist.DiscoveryDate, Mode=OneWay}" />
                    </TextBlock>

                    <!--  Main Actions  -->
                    <StackPanel
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        Spacing="16">
                        <Button
                            Height="52"
                            Padding="32,0"
                            CornerRadius="26"
                            Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="18" Glyph="&#xE768;" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="Play" />
                            </StackPanel>
                        </Button>
                        <Button
                            Width="52"
                            Height="52"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="26"
                            ToolTipService.ToolTip="Shuffle All">
                            <FontIcon FontSize="18" Glyph="&#xE8B1;" />
                        </Button>
                        <Button
                            Width="52"
                            Height="52"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="26"
                            ToolTipService.ToolTip="Start Artist Radio">
                            <FontIcon FontSize="18" Glyph="&#xEC15;" />
                        </Button>
                        <ToggleButton
                            Width="52"
                            Height="52"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="26"
                            IsChecked="{x:Bind MyViewModel.SelectedArtist.IsFavorite, Mode=TwoWay}"
                            ToolTipService.ToolTip="Favorite">
                            <FontIcon
                                FontSize="18"
                                Foreground="{ThemeResource SystemAccentColorLight2}"
                                Glyph="&#xEB51;" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--  ==========================================================  -->
            <!--  2. MAIN CONTENT SPLIT (Left: Music, Right: Deep Insights)  -->
            <!--  ==========================================================  -->
            <Grid
                Grid.Row="1"
                Padding="48,24"
                ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6.5*" />
                    <!--  Music  -->
                    <ColumnDefinition Width="3.5*" />
                    <!--  Analytics  -->
                </Grid.ColumnDefinitions>

                <!--  LEFT COLUMN: MUSIC  -->
                <StackPanel Grid.Column="0" Spacing="40">

                    <!--  TOP TRACKS LIST  -->
                    <StackPanel Spacing="16">
                        <TextBlock
                            FontWeight="Bold"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Popular Tracks" />

                        <ItemsRepeater ItemsSource="{Binding MyViewModel.SelectedArtist.SongsByArtist, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Padding="12,8"
                                        Background="Transparent"
                                        CornerRadius="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Track Number / Hover Play Icon  -->
                                        <TextBlock
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{Binding TrackNumber}" />

                                        <devWin:ImageEx
                                            Grid.Column="1"
                                            Width="40"
                                            Height="40"
                                            CornerRadius="4"
                                            Source="{Binding CoverImagePath}"
                                            Stretch="UniformToFill" />

                                        <!--  Title & Popularity Bar  -->
                                        <StackPanel
                                            Grid.Column="2"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <ProgressBar
                                                Width="60"
                                                Height="2"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Left"
                                                Foreground="{ThemeResource SystemAccentColor}"
                                                Maximum="100"
                                                Opacity="0.5"
                                                Value="{Binding PlayCompletedCount}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Text="{Binding PlayCompletedCount}" /> <Run Text="plays" />
                                        </TextBlock>

                                        <TextBlock
                                            Grid.Column="4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DurationFormatted}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!--  DISCOGRAPHY  -->
                    <StackPanel Spacing="16">
                        <Grid>
                            <TextBlock
                                FontWeight="Bold"
                                Style="{ThemeResource TitleTextBlockStyle}"
                                Text="Discography" />
                            <HyperlinkButton HorizontalAlignment="Right" Content="Show All" />
                        </Grid>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsRepeater ItemsSource="{x:Bind MyViewModel.SelectedArtist.AlbumsByArtist, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" Spacing="24" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="180" Spacing="12">
                                            <devWin:ImageEx
                                                Width="180"
                                                Height="180"
                                                CornerRadius="8"
                                                Source="{Binding ImagePath}"
                                                Stretch="UniformToFill" />
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="Bold"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding ReleaseYear}" />
                                                    •<Run Text="{Binding NumberOfTracks}" /> <Run Text="tracks" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>

                <!--  RIGHT COLUMN: NICHE DIMMER STATS  -->
                <StackPanel Grid.Column="1" Spacing="32">

                    <TextBlock
                        FontWeight="Bold"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="Your Insights" />

                    <!--  STAT CARD 1: The Pareto Effect  -->
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource SystemAccentColor}"
                                    Glyph="&#xE81E;" />
                                <TextBlock FontWeight="Bold" Text="Listening Persona: Fixated" />
                            </StackPanel>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                LineHeight="20"
                                TextWrapping="Wrap">
                                You heavily favor a few tracks.<Run
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind MyViewModel.SelectedArtist.ParetoPercentage, Mode=OneWay}" />
                                of all your plays come from just<Run
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind MyViewModel.SelectedArtist.ParetoTopSongsCount, Mode=OneWay}" />
                                songs.</TextBlock>
                        </StackPanel>
                    </Border>

                    <!--  STAT CARD 2: Attention / Listen-Through Rate  -->
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="16">
                            <TextBlock FontWeight="Bold" Text="Attention Score (Listen-Through)" />

                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Average Song Completion" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontWeight="Bold"
                                        Text="{x:Bind MyViewModel.SelectedArtist.AverageSongListenThroughRate, Mode=OneWay}" />
                                </Grid>
                                <ProgressBar
                                    Height="6"
                                    CornerRadius="3"
                                    Foreground="#4CAF50"
                                    Maximum="100"
                                    Value="{x:Bind MyViewModel.SelectedArtist.AverageSongListenThroughRate, Mode=OneWay}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    TextWrapping="Wrap">
                                    When you play this artist, you rarely skip before the song ends.
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  STAT CARD 3: Eddington & Catalog  -->
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid ColumnSpacing="20" RowSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Eddington  -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Eddington No."
                                    ToolTipService.ToolTip="You have played E songs at least E times." />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource SystemAccentColor}"
                                        Glyph="&#xE9D2;" />
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Text="{x:Bind MyViewModel.SelectedArtist.EddingtonNumber, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Catalog Completion  -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Catalog Explored" />
                                <TextBlock FontSize="24" FontWeight="Bold">
                                    <Run Text="{x:Bind MyViewModel.SelectedArtist.CompletionPercentage, Mode=OneWay}" />
                                    %</TextBlock>
                            </StackPanel>

                            <!--  Skips  -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Total Skips" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="#E57373"
                                    Text="{x:Bind MyViewModel.SelectedArtist.TotalSkipCount, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  BIO SECTION  -->
                    <StackPanel Margin="0,16,0,0" Spacing="12">
                        <TextBlock
                            FontWeight="Bold"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="About" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            LineHeight="22"
                            MaxLines="6"
                            Text="{x:Bind MyViewModel.SelectedArtist.Bio, Mode=OneWay}"
                            TextTrimming="WordEllipsis"
                            TextWrapping="Wrap" />
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>