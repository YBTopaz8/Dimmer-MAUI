<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dimmer.WinUI.Views.WinuiPages.SongDetailPage"
    x:Name="MyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CustomViews="using:Dimmer.WinUI.Views.CustomViews.WinuiViews"
    xmlns:achievements="using:Dimmer.WinUI.Views.WinuiPages.Achievements"
    xmlns:converters="using:Dimmer.WinUI.Utils.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:devWin="using:DevWinUI"
    xmlns:dgView="using:WinUI.TableView"
    xmlns:dimmSearch="clr-namespace:Dimmer.Data.ModelView.DimmerSearch;assembly=Dimmer"
    xmlns:lang="clr-namespace:Dimmer.Resources.Localization;assembly=Dimmer"
    xmlns:local="using:Dimmer.WinUI.Views.WinuiPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Dimmer.Data.ModelView;assembly=Dimmer"
    xmlns:modelsDb="clr-namespace:Dimmer.Data.Models;assembly=Dimmer"
    xmlns:modeltwo="clr-namespace:Dimmer.WinUI.Utils.Models"
    xmlns:queryBuilder="queries"
    xmlns:tql="clr-namespace:Dimmer.DimmerSearch.TQL;assembly=Dimmer"
    xmlns:vm="clr-namespace:Dimmer.WinUI.ViewModel"
    KeyDown="MyPage_KeyDown"
    Loaded="MyPage_Loaded"
    mc:Ignorable="d"
    >
    <Page.Resources />

    <Grid>

        <Grid PointerPressed="Grid_PointerPressed">
            <Image
                x:Name="BgImage"
                Opacity="0.05"
                Stretch="UniformToFill"
                />
            <Grid x:Name="FgGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Width="150"
                    Height="50"
                    Margin="10,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#111"
                    CornerRadius="5"
                    Visibility="Collapsed"
                    >
                    <StackPanel
                        Margin="12"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Collapsed"
                        >
                        <TextBlock
                            x:Name="CurrentSectionLabel"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Overview"
                            />
                    </StackPanel>
                </Border>


                <StackPanel Grid.Row="1">
                    <!--  The elements involved in the animation  -->
                    <StackPanel Orientation="Horizontal" Spacing="15">

                        <Button
                            x:Name="EditSongBtn"
                            Click="EditSongBtn_Click"
                            Content="Edit"
                            FontSize="19"
                            />

                        <Button
                            x:Name="EditSongAudioBtn"
                            Click="EditSongAudioBtn_Click"
                            Content="Edit Audio"
                            FontSize="19"
                            />
                    </StackPanel>

                    <Grid x:Name="SectionOverview" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>


                        <StackPanel
                            x:Name="detailedImageStackPanel"
                            Grid.Column="0"
                            Spacing="10"
                            >

                            <Image
                                x:Uid="detailedImage"
                                MaxWidth="350"
                                MaxHeight="350"
                                Loaded="detailedImage_Loaded"
                                />
                            <Button
                                x:Name="PlaySongBtn"
                                HorizontalAlignment="Center"
                                Click="PlaySongBtn_Click"
                                Loaded="PlaySongBtn_Loaded"
                                Visibility="Collapsed"
                                >
                                <FontIcon FontSize="45" Glyph="&#xF5B0;" />
                            </Button>
                        </StackPanel>
                        <Border Grid.Column="1">

                            <StackPanel HorizontalAlignment="Left" Spacing="5">
                                <StackPanel
                                    x:Name="UtilitiesSection"
                                    Background="Transparent"
                                    Orientation="Vertical"
                                    Spacing="10"
                                    >
                                    <TextBlock
                                        x:Name="TitleBlock"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="80"
                                        Style="{ThemeResource TitleTextBlockStyle}"
                                        Text="{x:Bind MyViewModel.CurrentPlayingSongView.Title}"
                                        TextWrapping="Wrap"
                                        />

                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Grid
                                            x:Name="RootGrid"
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            >
                                            <StackPanel x:Name="ArtistListPanel" HorizontalAlignment="Left">


                                                <ItemsRepeater
                                                    x:Name="ArtistToSong"
                                                    HorizontalAlignment="Center"
                                                    Loaded="ArtistToSong_Loaded"
                                                    >

                                                    <ItemsRepeater.ItemTemplate>

                                                        <DataTemplate>
                                                            <Button
                                                                x:Name="ArtistNameBtn"
                                                                Margin="0,10,0,0"
                                                                BorderThickness="1"
                                                                Click="Artist_Click"
                                                                CornerRadius="15"
                                                                Loaded="ArtistNameBtn_Loaded"
                                                                >
                                                                <StackPanel
                                                                    VerticalAlignment="Center"
                                                                    Background="Transparent"
                                                                    Orientation="Horizontal"
                                                                    Spacing="10"
                                                                    >
                                                                    <TextBlock FontSize="26" Text="{Binding Name}" />
                                                                    <StackPanel
                                                                        VerticalAlignment="Center"
                                                                        Orientation="Horizontal"
                                                                        Spacing="0"
                                                                        >
                                                                        <TextBlock FontSize="16" Text="(" />
                                                                        <TextBlock FontSize="16" Text="{Binding TotalSongsByArtist}" />
                                                                        <TextBlock FontSize="16" Text=")" />
                                                                        <TextBlock
                                                                            Margin="5,0,0,0"
                                                                            FontSize="16"
                                                                            Text="Songs"
                                                                            />

                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsRepeater.ItemTemplate>
                                                </ItemsRepeater>

                                            </StackPanel>

                                            <Border
                                                x:Name="ArtistDetailBorder"
                                                MinWidth="350"
                                                MaxWidth="750"
                                                MaxHeight="350"
                                                Padding="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#1E1E1E"
                                                BorderBrush="DarkSlateBlue"
                                                BorderThickness="2"
                                                Canvas.ZIndex="99"
                                                CornerRadius="15"
                                                Visibility="Collapsed"
                                                >

                                                <Grid>

                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Grid.Row="0">

                                                        <StackPanel
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top"
                                                            Orientation="Horizontal"
                                                            Spacing="10"
                                                            >

                                                            <Button
                                                                x:Name="ArtistPreviewButton"
                                                                Padding="10"
                                                                HorizontalAlignment="Center"
                                                                Background="Transparent"
                                                                Click="CloseArtistDetail_Click"
                                                                CornerRadius="12"
                                                                >
                                                                <FontIcon Foreground="White" Glyph="&#xE72B;" />
                                                            </Button>

                                                            <TextBlock
                                                                x:Name="ArtistMiniName"
                                                                Margin="0,0,0,0"
                                                                HorizontalAlignment="Center"
                                                                FontSize="28"
                                                                FontWeight="Bold"
                                                                Foreground="White"
                                                                Text="{Binding Name}"
                                                                />


                                                        </StackPanel>

                                                        <Button
                                                            Padding="8"
                                                            HorizontalAlignment="Center"
                                                            Background="Transparent"
                                                            BorderThickness="2"
                                                            Click="ArtistNameBtn_Click"
                                                            Content="View"
                                                            CornerRadius="12"
                                                            FontSize="15"
                                                            FontWeight="ExtraBold"
                                                            />

                                                    </StackPanel>

                                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">

                                                        <ItemsRepeater x:Name="ArtistSongsPreviewIR" Loaded="ArtistSongsPreviewIR_Loaded">
                                                            <ItemsRepeater.Layout>
                                                                <StackLayout Orientation="Vertical" Spacing="2" />
                                                            </ItemsRepeater.Layout>
                                                            <ItemsRepeater.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="11,0,11,0">


                                                                        <Grid
                                                                            Padding="2"
                                                                            BorderBrush="Gray"
                                                                            BorderThickness="0"
                                                                            ColumnSpacing="10"
                                                                            CornerRadius="5"
                                                                            >
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel Grid.Column="0" Spacing="5">

                                                                                <TextBlock
                                                                                    FontSize="16"
                                                                                    MaxLines="3"
                                                                                    Text="{Binding Title}"
                                                                                    TextWrapping="Wrap"
                                                                                    />

                                                                                <TextBlock
                                                                                    FontSize="9"
                                                                                    FontStyle="Italic"
                                                                                    MaxLines="3"
                                                                                    Text="{Binding AlbumName}"
                                                                                    TextWrapping="Wrap"
                                                                                    />

                                                                            </StackPanel>

                                                                            <StackPanel
                                                                                Grid.Column="1"
                                                                                Orientation="Horizontal"
                                                                                Spacing="5"
                                                                                >
                                                                                <Button
                                                                                    x:Name="PlaySongNowFromArtistListOfSongs"
                                                                                    Background="Transparent"
                                                                                    Click="PlaySongNowFromArtistListOfSongs_Click"
                                                                                    FontSize="10"
                                                                                    RightTapped="PlaySongNowFromArtistListOfSongs_RightTapped"
                                                                                    >
                                                                                    <FontIcon Glyph="&#xE768;" />
                                                                                </Button>
                                                                                <Button
                                                                                    x:Name="AddNextInQueue"
                                                                                    Background="Transparent"
                                                                                    Click="AddNextInQueue_Click"
                                                                                    FontSize="10"
                                                                                    >
                                                                                    <FontIcon Glyph="&#xEA37;" />
                                                                                </Button>
                                                                            </StackPanel>

                                                                        </Grid>
                                                                        <Rectangle Height="1" Fill="DarkSlateBlue" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsRepeater.ItemTemplate>
                                                        </ItemsRepeater>

                                                    </ScrollViewer>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel
                                        Margin="0,10,0,0"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        >

                                        <Button
                                            x:Name="AlbumBtn"
                                            HorizontalAlignment="Left"
                                            Background="Transparent"
                                            BorderThickness="2"
                                            Click="AlbumBtn_Click"
                                            Content="{x:Bind MyViewModel.CurrentPlayingSongView.AlbumName}"
                                            FontSize="30"
                                            PointerPressed="AlbumBtn_PointerPressed"
                                            />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="30"
                                            Text="{x:Bind MyViewModel.CurrentPlayingSongView.ReleaseYear}"
                                            />

                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">

                                        <Button
                                            Background="Transparent"
                                            BorderThickness="2"
                                            Content="{x:Bind MyViewModel.CurrentPlayingSongView.FileFormat}"
                                            />



                                        <Button
                                            x:Name="ViewInFolder"
                                            Command="{x:Bind MyViewModel.OpenAndSelectFileInExplorerCommand}"
                                            CommandParameter="{x:Bind MyViewModel.CurrentPlayingSongView}"
                                            ToolTipService.ToolTip="{x:Bind MyViewModel.CurrentPlayingSongView.FilePath}"
                                            >
                                            <FontIcon Glyph="&#xE838;" />
                                        </Button>

                                        <Button x:Name="ViewCharts" Click="ViewCharts_Click">
                                            <FontIcon Glyph="&#xEB05;" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button
                                            x:Name="FavBtn"
                                            VerticalAlignment="Bottom"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Click="FavBtn_Click"
                                            Foreground="SlateBlue"
                                            RightTapped="FavBtn_RightTapped"
                                            >

                                            <FontIcon Glyph="&#xEB52;" />
                                        </Button>

                                    </StackPanel>

                                    <RichTextBlock
                                        x:Name="BioBlock"
                                        Loaded="BioBlock_Loaded"
                                        TextWrapping="Wrap"
                                        />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Pivot Grid.Row="2">
                    <PivotItem>
                        <StackPanel
                            x:Name="SongStats"
                            Loaded="SongStats_Loaded"
                            Orientation="Horizontal"
                            >
                            <StackPanel
                                Padding="10"
                                BorderThickness="1"
                                CornerRadius="20"
                                >

                                <TextBlock FontSize="20" Text="{x:Bind MySongStatsViewModel.TextPredictability.Title, Mode=OneWay}" />
                                <TextBlock FontSize="16" Text="{x:Bind MySongStatsViewModel.TextPredictability.Subtitle, Mode=OneWay}" />
                                <devWin:Divider />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind MySongStatsViewModel.TextPredictability.Value, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>

                            <devWin:Divider />
                            <StackPanel
                                Padding="10"
                                BorderThickness="1"
                                CornerRadius="20"
                                >

                                <TextBlock FontSize="20" Text="{x:Bind MySongStatsViewModel.TextAvgListenDuration.Title, Mode=OneWay}" />
                                <TextBlock FontSize="16" Text="{x:Bind MySongStatsViewModel.TextAvgListenDuration.Subtitle, Mode=OneWay}" />
                                <devWin:Divider />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind MySongStatsViewModel.TextAvgListenDuration.Value, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>

                            <devWin:Divider />
                            <StackPanel
                                Padding="10"
                                BorderThickness="1"
                                CornerRadius="20"
                                >

                                <TextBlock FontSize="20" Text="{x:Bind MySongStatsViewModel.TextBingeFactor.Title, Mode=OneWay}" />
                                <TextBlock FontSize="16" Text="{x:Bind MySongStatsViewModel.TextBingeFactor.Subtitle, Mode=OneWay}" />
                                <devWin:Divider />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind MySongStatsViewModel.TextBingeFactor.Value, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>

                            <devWin:Divider />





                        </StackPanel>

                    </PivotItem>
                    <PivotItem>
                        <Grid Height="450">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <Style TargetType="ItemsRepeater">
                                        <Setter Property="Height" Value="400" />
                                    </Style>
                                </ResourceDictionary>
                            </Grid.Resources>
                            <ItemsRepeater
                                x:Name="ListDayOfWeekHeatmap"
                                Grid.Column="0"
                                Loaded="ListDayOfWeekHeatmap_Loaded"
                                >
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Padding="10"
                                            BorderBrush="{Binding ColorHex}"
                                            BorderThickness="1"
                                            CornerRadius="20"
                                            >
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock Text="{Binding Description}" />
                                            <TextBlock Text="{Binding Icon}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>





                            <ItemsRepeater
                                x:Name="ListWalkthrough"
                                Grid.Column="1"
                                Loaded="ListWalkthrough_Loaded"
                                >
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel BorderThickness="1" CornerRadius="20">
                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="Session Summary" />
                                                <TextBlock Text="{Binding SessionSummary}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="StartTime" />
                                                <TextBlock Text="{Binding StartTime}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="EventCount" />
                                                <TextBlock Text="{Binding EventCount}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="Total Listening Time Seconds" />
                                                <TextBlock Text="{Binding TotalListeningTimeSeconds}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <ItemsRepeater
                                x:Name="ListMonthlyTrend"
                                Grid.Column="2"
                                Loaded="ListMonthlyTrend_Loaded"
                                >
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Padding="10"
                                            BorderBrush="Gray"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            >
                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="Period" />
                                                <TextBlock Text="{Binding Period}" />
                                                <StackPanel Orientation="Horizontal" Spacing="5">

                                                    <TextBlock Text="(" />
                                                    <TextBlock Text="{Binding PlayCount}" />
                                                    <TextBlock Text=" dims)" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="ChangeVsPrevious" />
                                                <TextBlock Text="{Binding ChangeVsPrevious}" />
                                            </StackPanel>

                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <ItemsRepeater
                                x:Name="ListPlaySkipRatio"
                                Grid.Column="3"
                                Loaded="ListPlaySkipRatio_Loaded"
                                >
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Padding="10"
                                            BorderBrush="Gray"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            >
                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="Period" />
                                                <TextBlock Text="{Binding Period}" />

                                                <StackPanel Orientation="Horizontal" Spacing="5">

                                                    <TextBlock Text="(" />
                                                    <TextBlock Text="{Binding PlayCount}" />
                                                    <TextBlock Text=" dims)" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="Change Vs Previous" />
                                                <TextBlock
                                                    FontWeight="Bold"
                                                    Foreground="Orange"
                                                    Text="{Binding ChangeVsPrevious}"
                                                    />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <ItemsRepeater
                                x:Name="ListPerfectPairings"
                                Grid.Column="4"
                                Loaded="ListPerfectPairings_Loaded"
                                >
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Padding="10"
                                            BorderBrush="Gray"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            >
                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="Paired Song Title" />
                                                <TextBlock Text="{Binding PairedSongTitle}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="Times Played Together" />
                                                <TextBlock Text="{Binding TimesPlayedTogether}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="Context" />
                                                <TextBlock Text="{Binding Context}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <ItemsRepeater
                                x:Name="ListTimeOfDayHeatmap"
                                Grid.Column="5"
                                Loaded="ListTimeOfDayHeatmap_Loaded"
                                >
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            Padding="10"
                                            BorderBrush="Gray"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            >
                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="Period" />
                                                <TextBlock Text="{Binding Period}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="Play Count" />
                                                <TextBlock Text="{Binding PlayCount}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5">

                                                <TextBlock Text="ChangeVsPrevious" />
                                                <TextBlock Text="{Binding ChangeVsPrevious}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>



                        </Grid>
                    </PivotItem>
                    <PivotItem>

                        <!--  SECTION 3: LYRICS  -->
                        <StackPanel x:Name="SectionLyricsStackPanel" Background="Transparent">

                            <StackPanel Orientation="Horizontal">

                                <Button
                                    x:Name="LyricsSection"
                                    Background="Transparent"
                                    Content="Lyrics Section"
                                    FontSize="34"
                                    FontWeight="ExtraBold"
                                    />
                                <Button
                                    x:Name="EditIconBtn"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="LyricsSection_Click"
                                    >
                                    <FontIcon FontSize="24" Glyph="&#xE70F;" />
                                </Button>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                                    <ItemsRepeater ItemsSource="{x:Bind MyViewModel.SelectedSong.SyncLyricsCol, Mode=OneWay}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <Border>
                                                    <StackPanel
                                                        Background="Transparent"
                                                        Orientation="Horizontal"
                                                        Spacing="15"
                                                        >

                                                        <TextBlock FontSize="26" Text="{Binding Text}" />

                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>


                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>

                            </Grid>
                        </StackPanel>


                    </PivotItem>
                </Pivot>






            </Grid>
        </Grid>


    </Grid>
</Page>