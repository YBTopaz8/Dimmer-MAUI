<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dimmer.WinUI.Views.WinuiPages.SongDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="clr-namespace:Dimmer.Charts;assembly=Dimmer"
    xmlns:devWin="using:DevWinUI"
    xmlns:models="clr-namespace:Dimmer.Data.ModelView;assembly=Dimmer"
    xmlns:stats="clr-namespace:Dimmer.ViewModel.StatsVMs;assembly=Dimmer"
    xmlns:vm="clr-namespace:Dimmer.WinUI.ViewModel">

    <Grid>
        <!--  Blurred Background Image  -->
        <devWin:ImageEx
            x:Name="BgImage"
            Opacity="0.1"
            Source="{x:Bind DetailedSong.CoverImagePath, Mode=OneWay}"
            Stretch="UniformToFill" />
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.85" />

        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  1. Hero Header  -->
                <RowDefinition Height="Auto" />
                <!--  2. SelectorBar  -->
                <RowDefinition Height="*" />
                <!--  3. Dynamic Content  -->
            </Grid.RowDefinitions>

            <!--  ==========================================================  -->
            <!--  1. HERO HEADER  -->
            <!--  ==========================================================  -->
            <Grid
                Grid.Row="0"
                Margin="0,0,0,24"
                ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <devWin:ImageEx
                    Grid.Column="0"
                    Width="200"
                    Height="200"
                    CornerRadius="12"
                    Source="{x:Bind DetailedSong.CoverImagePath, Mode=OneWay}"
                    Stretch="UniformToFill" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Spacing="8">
                    <TextBlock
                        CharacterSpacing="150"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{ThemeResource SystemAccentColorLight2}"
                        Text="SONG" />

                    <TextBlock
                        FontSize="56"
                        FontWeight="Black"
                        Text="{x:Bind DetailedSong.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{x:Bind DetailedSong.ArtistName, Mode=OneWay}" />
                        <TextBlock
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="•" />
                        <TextBlock
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind DetailedSong.AlbumName, Mode=OneWay}" />
                        <TextBlock
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="•" />
                        <TextBlock
                            FontSize="20"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind DetailedSong.ReleaseYear, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            Height="40"
                            Padding="24,0"
                            Click="PlaySongBtn_Click"
                            CornerRadius="20"
                            Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE768;" />
                                <TextBlock FontWeight="SemiBold" Text="Play" />
                            </StackPanel>
                        </Button>
                        <Button
                            Width="40"
                            Height="40"
                            Click="EditSongAudioBtn_Click"
                            CornerRadius="20"
                            ToolTipService.ToolTip="Edit Audio">
                            <FontIcon FontSize="14" Glyph="&#xE8D8;" />
                        </Button>
                        <ToggleButton
                            Width="40"
                            Height="40"
                            CornerRadius="20"
                            IsChecked="{x:Bind DetailedSong.IsFavorite, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE113;" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--  ==========================================================  -->
            <!--  2. SELECTOR BAR (The Tabs)  -->
            <!--  ==========================================================  -->
            <SelectorBar
                x:Name="ViewSelector"
                Grid.Row="1"
                Margin="0,0,0,24"
                SelectionChanged="ViewSelector_SelectionChanged">
                <SelectorBarItem IsSelected="True" Text="Overview" />
                <SelectorBarItem Text="Deep Analytics" />
                <SelectorBarItem Text="Lyrics" />
            </SelectorBar>

            <!--  ==========================================================  -->
            <!--  3. DYNAMIC CONTENT AREA  -->
            <!--  ==========================================================  -->
            <Grid Grid.Row="2">

                <!--  TAB 1: OVERVIEW  -->
                <ScrollViewer x:Name="OverviewTab" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="32">
                        <!--  Basic Stats & Details  -->
                        <TextBlock
                            FontWeight="Bold"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Details" />
                        <!--  Add File info, Genre, BPM, FileSize, etc. here  -->
                    </StackPanel>
                </ScrollViewer>

                <!--  TAB 2: DEEP ANALYTICS  -->
                <ScrollViewer
                    x:Name="AnalyticsTab"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Padding="0,0,16,32" Spacing="32">

                        <TextBlock
                            FontWeight="Bold"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Listening Habits" />

                        <!--  KPI Grid (The Custom Stats)  -->
                        <VariableSizedWrapGrid
                            ItemHeight="100"
                            ItemWidth="200"
                            MaximumRowsOrColumns="4"
                            Orientation="Horizontal">

                            <!--  Stat Card Template (Used manually for illustration)  -->
                            <Border
                                Margin="4"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind MySongStatsViewModel.TextCompletionRate.Title, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="{ThemeResource SystemAccentColorLight2}"
                                        Text="{x:Bind MySongStatsViewModel.TextCompletionRate.Value, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind MySongStatsViewModel.TextCompletionRate.Subtitle, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="4"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind MySongStatsViewModel.TextBingeFactor.Title, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Text="{x:Bind MySongStatsViewModel.TextBingeFactor.Value, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="4"
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind MySongStatsViewModel.TextPredictability.Title, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Text="{x:Bind MySongStatsViewModel.TextPredictability.Value, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind MySongStatsViewModel.TextPredictability.Subtitle, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <!--  Add more cards for Eddington, TimeToSkip, etc...  -->
                        </VariableSizedWrapGrid>

                        <!--  Perfect Pairings Repeater  -->
                        <TextBlock
                            FontWeight="Bold"
                            Style="{ThemeResource SubtitleTextBlockStyle}"
                            Text="Usually Played With..." />
                        <ItemsRepeater ItemsSource="{x:Bind MySongStatsViewModel.ListPerfectPairings, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="16" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="220"
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid ColumnDefinitions="40,*" ColumnSpacing="12">
                                            <devWin:ImageEx
                                                Width="40"
                                                Height="40"
                                                CornerRadius="4"
                                                Source="{Binding CoverImagePath}"
                                                Stretch="UniformToFill" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontWeight="Bold"
                                                    Text="{Binding PairedSongTitle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{Binding TimesPlayedTogether}" />
                                                    plays together</TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>

                <!--  TAB 3: LYRICS  -->
                <ScrollViewer
                    x:Name="LyricsTab"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="800"
                        HorizontalAlignment="Left"
                        Spacing="16">
                        <TextBlock
                            FontWeight="Bold"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Lyrics" />
                        <ItemsRepeater ItemsSource="{x:Bind DetailedSong.SyncLyricsCol, Mode=OneWay}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="0,8"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Opacity="0.8"
                                        Text="{Binding Text}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>
    </Grid>
</Page>