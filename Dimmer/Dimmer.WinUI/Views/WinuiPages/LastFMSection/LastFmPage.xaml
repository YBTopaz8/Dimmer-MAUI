<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dimmer.WinUI.Views.WinuiPages.LastFMSection.LastFmPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dgView="using:WinUI.TableView"
    xmlns:entities="using:Hqub.Lastfm.Entities"
    xmlns:local="using:Dimmer.WinUI.Views.WinuiPages.LastFMSection"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>

        <Grid
            x:Name="LastFMGridNonAuth"
            Padding="40"
            Background="Transparent">
            <StackPanel HorizontalAlignment="Center" Visibility="{x:Bind MyLastFMViewModel.IsLastfmAuthenticated, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}">

                <TextBox
                    x:Name="LastFMUname"
                    FontSize="25"
                    Header="Enter your Last FM username:"
                    KeyUp="LastFMUname_KeyUp"
                    PlaceholderText="User Name"
                    TextChanged="LastFMUname_TextChanged" />

                <Button
                    x:Name="LoginLastFMBtn"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Background="#BE0606"
                    Click="LoginLastFM_Click"
                    Content="Login to Last FM"
                    FontSize="19"
                    FontWeight="Bold"
                    IsEnabled="{x:Bind MyLastFMViewModel.IsLastFMAuthButtonClickable, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}" />
                <TextBlock Text="LastFM UserName Required" Visibility="{x:Bind MyLastFMViewModel.IsLastFMNeedsUsername}" />
            </StackPanel>


            <StackPanel Visibility="{x:Bind MyLastFMViewModel.IsLastfmAuthenticated, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="0.3*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Spacing="5">

                        <Button
                            HorizontalAlignment="Right"
                            Background="DarkRed"
                            BorderBrush="DarkRed"
                            Click="LogoutLastFM_Click"
                            Content="Logout" />


                        <Border CornerRadius="40">
                            <Image
                                Width="60"
                                Height="60"
                                Source="{x:Bind MyViewModel.CurrentUserLocal.LastFMAccountInfo.Image.Url, Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Border>
                        <TextBlock
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            FontSize="24"
                            Foreground="White"
                            Text="{x:Bind MyViewModel.CurrentUserLocal.LastFMAccountInfo.RealName, Mode=OneWay}" />


                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="24"
                                Foreground="White"
                                Text="{x:Bind MyViewModel.CurrentUserLocal.LastFMAccountInfo.Playcount, Mode=OneWay}" />
                            <TextBlock
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                FontSize="24"
                                Foreground="White"
                                Text="Scrobbles" />

                        </StackPanel>



                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
        <Grid x:Name="LastFMAuthedSection">
            <!--  LOADING OVERLAY  -->
            <ProgressRing
                Width="60"
                Height="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Canvas.ZIndex="100"
                IsActive="{x:Bind MyLastFMViewModel.IsBusy, Mode=OneWay}" />

            <!--  DASHBOARD SCROLL  -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{x:Bind MyLastFMViewModel.IsLastfmAuthenticated, Mode=OneWay}">

                <StackPanel Padding="32" Spacing="24">

                    <!--  ROW 1: HERO HEADER (Profile & Milestones)  -->
                    <Grid
                        Height="220"
                        Padding="32"
                        CornerRadius="16">
                        <Grid.Background>
                            <AcrylicBrush
                                FallbackColor="#1A1A24"
                                TintColor="#1A1A24"
                                TintOpacity="0.85" />
                        </Grid.Background>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <PersonPicture
                            Grid.Column="0"
                            Width="130"
                            Height="130"
                            VerticalAlignment="Center"
                            ProfilePicture="{x:Bind MyViewModel.CurrentUserLocal.LastFMAccountInfo.Image.Url, Mode=OneWay}" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="32,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <TextBlock
                                FontSize="42"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{x:Bind MyViewModel.CurrentUserLocal.LastFMAccountInfo.RealName, Mode=OneWay}" />

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock>
                                    <Run
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="DarkSlateBlue"
                                        Text="{x:Bind MyViewModel.CurrentUserLocal.LastFMAccountInfo.Playcount, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Bottom"
                                    FontSize="18"
                                    Foreground="LightGray"
                                    Text="Total Scrobbles" />
                            </StackPanel>
                            <TextBlock>

                                <Run
                                    FontSize="14"
                                    Foreground="Gray"
                                    Text="Scrobbling since {0}" />

                                <Run
                                    FontSize="14"
                                    Foreground="Gray"
                                    Text="{x:Bind MyViewModel.CurrentUserLocal.LastFMAccountInfo.Registered.Year, Mode=OneWay}" />
                            </TextBlock>

                        </StackPanel>

                        <!--  Milestone Widget  -->
                        <Border
                            Grid.Column="2"
                            Width="240"
                            Padding="20"
                            VerticalAlignment="Center"
                            Background="#262633"
                            CornerRadius="12">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    CharacterSpacing="100"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="Gray"
                                    Text="NEXT MILESTONE" />

                                <ProgressBar
                                    Height="10"
                                    CornerRadius="5"
                                    Foreground="DarkSlateBlue"
                                    Maximum="1"
                                    Value="{x:Bind MyLastFMViewModel.LastFmMilestoneProgress, Mode=OneWay}" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="15"
                                    Foreground="White"
                                    Text="{x:Bind MyLastFMViewModel.LastFmMilestoneText, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  ROW 2: ANALYTICS (Charts)  -->
                    <Grid
                        Height="300"
                        ColumnDefinitions="*, 350"
                        ColumnSpacing="24">

                        <!--  Weekly Chart  -->
                        <Border
                            Grid.Column="0"
                            Padding="24"
                            Background="#111116"
                            CornerRadius="16">
                            <Grid RowDefinitions="Auto,*">
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="0,0,0,16"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="Recent Activity" />
                                    <TextBlock
                                        Margin="0,0,0,3"
                                        VerticalAlignment="Bottom"
                                        FontSize="14"
                                        Foreground="DarkSlateBlue"
                                        Text="{x:Bind MyLastFMViewModel.WeeklyScrobbleCountText, Mode=OneWay}" />
                                </StackPanel>

                                <lvc:CartesianChart
                                    Grid.Row="1"
                                    Series="{x:Bind MyLastFMViewModel.WeeklyScrobblesChart, Mode=OneWay}"
                                    TooltipPosition="Top"
                                    XAxes="{x:Bind MyLastFMViewModel.ChartXAxes, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <!--  Time of Day Doughnut  -->
                        <Border
                            Grid.Column="1"
                            Padding="24"
                            Background="#111116"
                            CornerRadius="16">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock
                                    Grid.Row="0"
                                    Margin="0,0,0,8"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="Listening Habits" />

                                <lvc:PieChart
                                    Grid.Row="1"
                                    CornerRadius="20"
                                    LegendPosition="Bottom"
                                    Series="{x:Bind MyLastFMViewModel.TimeOfDayChart, Mode=OneWay}" />

                                <!--  Center Text  -->
                                <TextBlock
                                    Grid.Row="1"
                                    Width="100"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="{x:Bind MyLastFMViewModel.FavoriteListeningTime, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!--  ROW 3: LOVED BUT MISSING (Actionable Utilities)  -->
                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Foreground="IndianRed"
                                    Text="Loved &amp; Missing" />
                                <TextBlock
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Bottom"
                                    FontSize="14"
                                    Foreground="Gray"
                                    Text="Songs you love on Last.fm but aren't downloaded here." />
                            </StackPanel>

                            <Button
                                HorizontalAlignment="Right"
                                Background="#262633"
                                Click="ExportAbsentSongsToTxtBtn_Click"
                                Content="Export List (.txt)" />
                        </Grid>

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled" 
                            VerticalScrollBarVisibility="Disabled">
                            <GridView
                                ItemsSource="{x:Bind MyLastFMViewModel.MissingLovedTracks, Mode=OneWay}"
                                SelectionMode="None"
                                ShowsScrollingPlaceholders="False">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid MaximumRowsOrColumns="1" Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate x:DataType="entities:Track">
                                        <Grid
                                            Width="220"
                                            Margin="0,0,16,0"
                                            Padding="12"
                                            Background="#111116"
                                            CornerRadius="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Spacing="8">
                                                <Border Height="140" CornerRadius="8">
                                                    <Image Source="{Binding Images[3].Url, Mode=OneWay}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="Gray"
                                                    Text="{Binding Artist.Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Button
                                                Grid.Row="1"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch"
                                                Background="IndianRed"
                                                Click="SearchOnline_Click"
                                                Content="Search Online" />
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </ScrollViewer>
                    </StackPanel>

                    <!--  ROW 4: RECENT SCROBBLES  -->
                    <StackPanel Margin="0,24,0,0" Spacing="12">
                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Text="Recent Scrobbles" />

                        <ListView
                            IsItemClickEnabled="True"
                            ItemClick="RecentTrack_ItemClick"
                            ItemsSource="{x:Bind MyLastFMViewModel.CollectionOfUserRecentTracks, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="entities:Track">
                                    <Grid
                                        Padding="12"
                                        Background="Transparent"
                                        ColumnSpacing="16"
                                        CornerRadius="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Indicator if it exists locally  -->
                                        <Border
                                            Grid.Column="0"
                                            Width="4"
                                            Height="30"
                                            Background="DarkSlateBlue"
                                            CornerRadius="2"
                                            Visibility="{Binding IsOnPresentDevice, Converter={StaticResource BoolToVis}}" />

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="16"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                FontSize="14"
                                                Foreground="Gray"
                                                Text="{Binding Artist.Name}" />
                                        </StackPanel>

                                        <FontIcon
                                            Grid.Column="2"
                                            Margin="0,0,24,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Foreground="IndianRed"
                                            Glyph="&#xEB52;"
                                            Visibility="{Binding UserLoved, Converter={StaticResource BoolToVis}}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Width="100"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="Gray"
                                            Text="{Binding Date, Converter={StaticResource EventDateToTimeAgoConverter}}"
                                            TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>