<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Name="MyPageGrid"
    x:Class="Dimmer.WinUI.Views.WinuiPages.AllSongsListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:converters="clr-namespace:Dimmer.Utilities.TypeConverters;assembly=Dimmer"
    xmlns:convertersWinUI="using:Dimmer.WinUI.Utils.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:devWin="using:DevWinUI"
    xmlns:dgView="using:WinUI.TableView"
    xmlns:dimmSearch="clr-namespace:Dimmer.Data.ModelView.DimmerSearch;assembly=Dimmer"
    xmlns:lang="clr-namespace:Dimmer.Resources.Localization;assembly=Dimmer"
    xmlns:local="using:Dimmer.WinUI.Views.CustomViews.WinuiViews"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:models="clr-namespace:Dimmer.Data.ModelView;assembly=Dimmer"
    xmlns:modelsDb="clr-namespace:Dimmer.Data.Models;assembly=Dimmer"
    xmlns:modeltwo="clr-namespace:Dimmer.WinUI.Utils.Models"
    xmlns:queryBuilder="queries"
    xmlns:tql="clr-namespace:Dimmer.DimmerSearch.TQL;assembly=Dimmer"
    xmlns:viewmodel="using:Dimmer.ViewModel"
    xmlns:vm="clr-namespace:Dimmer.WinUI.ViewModel"
    Loaded="MyPageGrid_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>


            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <media:AcrylicBrush
                        x:Key="CustomAcrylicInAppBrush"
                        FallbackColor="Green"
                        TintColor="Black"
                        TintOpacity="0.8" />
                    <media:AcrylicBrush
                        x:Key="CustomAcrylicInAppLuminosity"
                        FallbackColor="SkyBlue"
                        TintColor="SkyBlue"
                        TintOpacity="0.8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>


            <DataTemplate x:Key="ColorTemplate" x:DataType="SolidColorBrush">
                <StackPanel AutomationProperties.Name="{x:Bind Color}" Orientation="Horizontal">
                    <Rectangle
                        Width="20"
                        Height="20"
                        Fill="{x:Bind}" />
                    <TextBlock Margin="4,0,0,0" Text="{x:Bind Color}" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid
            Margin="10"
            RowSpacing="10"
            Visibility="Visible">

            <Grid Grid.Row="1" Visibility="Visible">
                <dgView:TableView
                    x:Name="MySongsTableView"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    d:DataContext="{d:DesignInstance Type=vm:BaseViewModelWin}"
                    AllowFocusOnInteraction="False"
                    AllowFocusWhenDisabled="False"
                    AutoGenerateColumns="False"
                    CanDragItems="True"
                    CellDoubleTapped="MySongsTableView_CellDoubleTapped"
                    DoubleTapped="TableView_DoubleTapped"
                    IsItemClickEnabled="True"
                    IsMultiSelectCheckBoxEnabled="True"
                    IsRightTapEnabled="True"
                    IsSwipeEnabled="False"
                    ItemsSource="{Binding SearchResults, Mode=OneWay}"
                    Loaded="MySongsTableView_Loaded"
                    SelectionMode="Single"
                    ShowFilterItemsCount="True"
                    Sorting="MySongsTableView_Sorting"
                    Style="{StaticResource AcrylicDataGridStyle}"
                    Tapped="MySongsTableView_Tapped">
                    <dgView:TableView.RowContextFlyout>
                        <MenuFlyout
                            devWin:MenuFlyoutAttach.AutoCloseByClickOnSecondaryMenuItems="True"
                            devWin:MenuFlyoutAttach.SecondaryMenuPlacement="Top"
                            AreOpenCloseAnimationsEnabled="True"
                            Opening="MenuFlyout_Opening">

                            <!--  ===================================================================  -->
                            <!--  TOP CARD: RICH SONG HEADER + HORIZONTAL QUICK ACTIONS  -->
                            <!--  ===================================================================  -->
                            <devWin:MenuFlyoutAttach.SecondaryMenu>
                                <devWin:MenuFlyoutSecondaryItems>
                                    <Grid
                                        Width="380"
                                        Padding="12,12,12,6"
                                        d:DataContext="{d:DesignInstance Type=vm:BaseViewModelWin}"
                                        Loaded="Grid_Loaded"
                                        RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  Row 0: Art + Metadata Header  -->
                                        <Grid Grid.Row="0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  Album Art with subtle rounded corners  -->
                                            <Border
                                                Grid.Column="0"
                                                Width="68"
                                                Height="68"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <Grid>
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="28"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Glyph="&#xE8D6;" />
                                                    <devWin:ImageEx
                                                        CornerRadius="8"
                                                        Source="{Binding CoverImagePath, Mode=OneWay}"
                                                        Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <!--  Song Details  -->
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Spacing="2">
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    MaxLines="1"
                                                    Text="{Binding Title, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    MaxLines="1"
                                                    Text="{Binding OtherArtistsName, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    MaxLines="1"
                                                    Text="{Binding AlbumName, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <!--  Audio Specs Badge Pills (e.g. FLAC • 24-bit • 1411 kbps • 120 BPM)  -->
                                                <StackPanel
                                                    Margin="0,3,0,0"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <Border
                                                        Padding="5,1"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4">
                                                        <TextBlock
                                                            FontSize="10"
                                                            FontWeight="Bold"
                                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                            Text="{Binding FileFormat, Mode=OneWay}" />
                                                    </Border>

                                                    <Border
                                                        Padding="5,1"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4">
                                                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                            <Run Text="{Binding DurationFormatted, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Border>

                                                    <Border
                                                        Padding="5,1"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4">
                                                        <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                                            <Run Text="{Binding BPM, Mode=OneWay}" />
                                                            <Run Text="BPM" />
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!--  Row 1: Divider  -->
                                        <MenuFlyoutSeparator Grid.Row="1" Margin="-12,0,-12,0" />

                                        <!--  Row 2: Horizontal Quick-Tap Command Bar  -->
                                        <StackPanel
                                            Grid.Row="2"
                                            Margin="0,-4,0,0"
                                            HorizontalAlignment="Stretch"
                                            Orientation="Horizontal">
                                            <AppBarButton
                                                x:Name="PlayAppBarBtn"
                                                Width="60"
                                                Click="PlayAppBarBtn_Click"
                                                Icon="Play"
                                                Label="Play"
                                                ToolTipService.ToolTip="Play immediately" />
                                            <AppBarButton
                                                x:Name="PlayNextAppBarBtn"
                                                Width="60"
                                                Click="PlayNextAppBarBtn_Click"
                                                Label="Next"
                                                PointerPressed="PlayAppBarBtn_PointerPressed"
                                                ToolTipService.ToolTip="Play next in queue">
                                                <AppBarButton.Icon>
                                                    <FontIcon Glyph="&#xE72A;" />
                                                </AppBarButton.Icon>
                                            </AppBarButton>
                                            <AppBarButton
                                                x:Name="AddEndAppBarBtn"
                                                Width="60"
                                                Click="AddEndAppBarBtn_Click"
                                                Icon="Add"
                                                Label="Queue"
                                                ToolTipService.ToolTip="Add to queue end" />
                                            <AppBarButton
                                                Width="60"
                                                Label="Fav"
                                                ToolTipService.ToolTip="Toggle Favorite">
                                                <AppBarButton.Icon>
                                                    <FontIcon Glyph="&#xEB51;" />
                                                </AppBarButton.Icon>
                                            </AppBarButton>
                                            <AppBarButton
                                                x:Name="AddNoteAppBarBtn"
                                                Width="60"
                                                Click="AddNoteAppBarBtn_Click"
                                                Icon="Edit"
                                                Label="Note"
                                                ToolTipService.ToolTip="Add personal note to this song" />
                                        </StackPanel>
                                    </Grid>
                                </devWin:MenuFlyoutSecondaryItems>
                            </devWin:MenuFlyoutAttach.SecondaryMenu>


                            <!--  ===================================================================  -->
                            <!--  VERTICAL CONTEXT MENU ITEMS  -->
                            <!--  ===================================================================  -->

                            <!--  1. QUEUE & PLAYLIST MANAGEMENT  -->
                            <MenuFlyoutItem Text="Play Next">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE893;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Add to End of Queue">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE109;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem Text="Add to Playlist">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE142;" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem Text="New Playlist...">
                                    <MenuFlyoutItem.Icon>
                                        <SymbolIcon Symbol="Add" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <!--  Bind to user playlists or populate in Opening handler  -->
                                <MenuFlyoutItem Text="Chill Vibes" />
                                <MenuFlyoutItem Text="Workout Pump" />
                                <MenuFlyoutItem Text="Night Drive" />
                            </MenuFlyoutSubItem>

                            <MenuFlyoutSeparator />

                            <!--  2. DIMMER NICHE DSP / AUDIO ENGINE FEATURES  -->
                            <MenuFlyoutSubItem Text="Special Playback Modes">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xEC16;" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem Text="Normal Engine" />
                                <MenuFlyoutItem Text="Nightcore Mode (+3 semitones, 1.25x speed)">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE735;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Slowed &amp; Reverb (-3 semitones, 0.85x speed)">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE93C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Hi-Fi Smart Master Mode">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEFA9;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Export Rendered Remix to Disk...">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEDE1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyoutSubItem>

                            <!--  3. SEGMENT & A-B LOOPING (Niche feature in your SongModelView!)  -->
                            <MenuFlyoutSubItem Text="Loops &amp; Segments">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE8EE;" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem Text="Set as Custom Segment (Loop Chorus)" />
                                <MenuFlyoutItem Text="Clear Saved Segment Points" />
                            </MenuFlyoutSubItem>

                            <MenuFlyoutSeparator />

                            <!--  4. LYRICS & USER MEMORIES  -->
                            <MenuFlyoutItem Text="View &amp; Calibrate Synced Lyrics">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xED15;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Song Notes &amp; Memories">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <!--  5. ANALYTICS & STATS (Leveraging your rich SongModelView stats!)  -->
                            <MenuFlyoutSubItem Text="Track Insights">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE9D2;" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem IsEnabled="False" Text="{Binding PlayCount, Mode=OneWay}" />
                                <MenuFlyoutItem IsEnabled="False" Text="{Binding SkipCount, Mode=OneWay}" />
                                <MenuFlyoutItem IsEnabled="False" Text="{Binding ListenThroughRate, Mode=OneWay}" />
                                <MenuFlyoutItem IsEnabled="False" Text="{Binding PlayStreakDays, Mode=OneWay}" />
                                <MenuFlyoutItem IsEnabled="False" Text="{Binding EddingtonNumber, Mode=OneWay}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="View Detailed Listening Graph" />
                            </MenuFlyoutSubItem>

                            <MenuFlyoutSeparator />

                            <!--  6. NAVIGATION & DISCOVERY  -->
                            <MenuFlyoutItem Text="Go to Artist">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Go to Album">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE93C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Find Matching BPM Tracks">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE81E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                            <MenuFlyoutSeparator />

                            <!--  7. FILE SYSTEM & SYSTEM PROPERTIES  -->
                            <MenuFlyoutSubItem Text="File &amp; Metadata">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem Text="Show in File Explorer">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEC50;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Copy File Path">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Edit Song Tags (ID3 Metadata)...">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE70F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="Delete from Library / Disk">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyoutSubItem>

                        </MenuFlyout>
                    </dgView:TableView.RowContextFlyout>
                    <dgView:TableView.Columns>

                        <!--  Column for the Cover Art  -->
                        <dgView:TableViewTemplateColumn
                            x:Name="ImgCol"
                            Width="*"
                            MinWidth="180">
                            <dgView:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="CardBorder"
                                        Width="80"
                                        Margin="5,0"
                                        AllowFocusOnInteraction="False"
                                        Background="Transparent"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        DoubleTapped="CardBorder_DoubleTapped"
                                        IsDoubleTapEnabled="True"
                                        IsHitTestVisible="True">
                                        <Grid
                                            x:Name="CoverImageGrid"
                                            HorizontalAlignment="Left"
                                            PointerReleased="CardBorder_PointerReleased">

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="auto" />

                                            </Grid.RowDefinitions>

                                            <StackPanel
                                                Grid.Row="0"
                                                Margin="0,0,0,5"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Orientation="Horizontal"
                                                Spacing="5">


                                                <FontIcon
                                                    Foreground="SlateBlue"
                                                    Glyph="&#xE768;"
                                                    Visibility="{Binding IsCurrentPlayingHighlight, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <FontIcon
                                                    Width="20"
                                                    Height="20"
                                                    Foreground="SlateBlue"
                                                    Glyph="&#xE720;"
                                                    Visibility="{Binding HasSyncedLyrics, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <FontIcon
                                                    Width="20"
                                                    Height="20"
                                                    Foreground="SlateBlue"
                                                    Glyph="&#xEB52;"
                                                    Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                            <devWin:ImageEx
                                                x:Name="coverArtImage"
                                                Grid.Row="1"
                                                Width="65"
                                                HorizontalAlignment="Left"
                                                x:FieldModifier="Public"
                                                Loaded="CoverArtImage_Loaded"
                                                RightTapped="coverArtImage_RightTapped"
                                                Source="{Binding CoverImagePath, Converter={StaticResource StringToImageConverter}}"
                                                Stretch="UniformToFill" />



                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding FileFormat}" />



                                            </Grid>
                                        </Grid>

                                    </Border>
                                </DataTemplate>
                            </dgView:TableViewTemplateColumn.CellTemplate>
                        </dgView:TableViewTemplateColumn>


                        <dgView:TableViewTextColumn
                            x:Name="Title"
                            Width="*"
                            MinWidth="300"
                            Binding="{Binding Title}"
                            Header="Title"
                            IsReadOnly="True"
                            ToolTipService.Placement="Mouse"
                            ToolTipService.ToolTip="{Binding CurrentPlayingSongView.Title, Mode=OneWay}" />



                        <dgView:TableViewTextColumn
                            x:Name="ArtistsColumn"
                            Width="*"
                            MinWidth="200"
                            Binding="{Binding OtherArtistsName}"
                            Header="Artists"
                            IsReadOnly="True" />

                        <dgView:TableViewTextColumn
                            x:Name="AlbumColumn"
                            Width="*"
                            Binding="{Binding AlbumName}"
                            Header="Album"
                            IsReadOnly="True" />

                        <dgView:TableViewTextColumn
                            x:Name="DurationFormatted"
                            Binding="{Binding DurationFormatted}"
                            Header="⌛"
                            IsReadOnly="True" />



                        <dgView:TableViewTextColumn
                            x:Name="PlayCompletedCount"
                            Width="80"
                            Binding="{Binding PlayCompletedCount}"
                            Header="🎶"
                            IsReadOnly="True" />

                        <dgView:TableViewCheckBoxColumn
                            x:Name="IsFavorite"
                            Width="140"
                            Binding="{Binding IsFavorite}"
                            Header="Favorite?"
                            IsReadOnly="True" />



                        <dgView:TableViewDateColumn
                            x:Name="LastPlayed"
                            Width="140"
                            Binding="{Binding LastPlayed}"
                            Header="LastPlayed"
                            IsReadOnly="True" />


                    </dgView:TableView.Columns>
                </dgView:TableView>

                <devWin:OrbitLoadingIndicator
                    x:Name="LoadingIndicator"
                    Width="150"
                    Height="150"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsBusy="true"
                    Loaded="LoadingIndicator_Loaded" />
                <devWin:GotoTop
                    Margin="0,0,20,20"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Animated="True"
                    AutoHiding="True"
                    Tapped="GotoTop_Tapped"
                    Target="{Binding ElementName=MySongsTableView}" />
            </Grid>


        </Grid>


        <local:SingleSongDetailsPopupView
            x:Name="SingleSongPopup"
            DismissedRequested="SingleSongPopup_DismissedRequested"
            Loaded="SingleSongPopup_Loaded"
            Visibility="Collapsed" />
    </Grid>
</Page>

