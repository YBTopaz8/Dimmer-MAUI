<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Dimmer.WinUI.Views.WinuiPages.SingleSongPage.EditSongPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Dimmer.WinUI.ViewModel.SingleSongVMSection"
    d:DataContext="{d:DesignInstance Type=vm:EditSongViewModel}"
    mc:Ignorable="d">

    <Grid Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <!--  Command / Header Bar  -->
            <RowDefinition Height="Auto" />
            <!--  Status InfoBar  -->
            <RowDefinition Height="Auto" />
            <!--  Main Content Area  -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Command Bar / Top Bar  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <Button
                    x:Name="BackBtn"
                    Click="BackButton_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Go Back">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE72B;" />
                        <TextBlock VerticalAlignment="Center" Text="Back" />
                    </StackPanel>
                </Button>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Song Metadata Editor" />
            </StackPanel>

            <!--  Actions  -->
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{Binding DiscardChangesCommand}"
                    Content="Discard"
                    IsEnabled="{x:Bind ViewModel.HasChanges, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.SaveChangesCommand}"
                    IsEnabled="{x:Bind ViewModel.HasChanges, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                        <TextBlock Text="Save Changes" />
                        <InfoBadge Visibility="{x:Bind ViewModel.HasChanges, Mode=OneWay}" Value="{x:Bind ViewModel.TotalChangesCount, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Notifications InfoBar  -->
        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

        <!--  Main Content Area  -->
        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <!--  Hero / Cover Art Column  -->
                <ColumnDefinition Width="320" />
                <!--  Categorized Tab Navigation Column  -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Left: Hero Card (Cover Art & Quick Summary)  -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Cover Art & Actions Card  -->
                <Border
                    Grid.Row="0"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" Spacing="14">
                        <Grid
                            Width="250"
                            Height="250"
                            CornerRadius="8">
                            <Image
                                x:Name="detailedImage"
                                Loaded="DetailedImage_Loaded"
                                Source="{x:Bind ViewModel.EditingSong.CoverImagePath, Mode=OneWay}"
                                Stretch="UniformToFill" />
                            <Border Background="{ThemeResource SystemControlBackgroundBaseMediumLowBrush}" Visibility="{x:Bind ViewModel.EditingSong.CoverImagePath, Mode=OneWay, Converter={StaticResource StringNullOrEmptyToVisibility}}">
                                <FontIcon
                                    FontSize="48"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xEC4F;" />
                            </Border>
                        </Grid>

                        <!--  Cover Actions Dropdown Button  -->
                        <DropDownButton HorizontalAlignment="Stretch" Content="Manage Cover Art">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.PickImageFromFileCommand}" Text="Choose from File...">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8B9;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Command="{x:Bind ViewModel.RemoveCoverImageCommand}" Text="Remove Cover">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <!--  Album-Wide Alternatives Carousel  -->
                        <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasAlbumArtCandidates, Mode=OneWay}">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Other Co-Album Art:" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.AlbumArtCandidates, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding ElementName=detailedImage, Path=DataContext.ApplyAlbumCandidateImageCommand}"
                                                CommandParameter="{Binding .}">
                                                <Image
                                                    Width="48"
                                                    Height="48"
                                                    Source="{Binding .}"
                                                    Stretch="UniformToFill" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Technical Badge Pill Info  -->
                <Border
                    Grid.Row="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontSize="16"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="File Specifications" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border
                                Padding="6,2"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{x:Bind ViewModel.EditingSong.FileFormat, Mode=OneWay}" />
                            </Border>
                            <Border
                                Padding="6,2"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="4">
                                <TextBlock FontSize="11" Text="{x:Bind ViewModel.EditingSong.DurationFormatted, Mode=OneWay}" />
                            </Border>
                            <Border
                                Padding="6,2"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                CornerRadius="4">
                                <TextBlock FontSize="11" Text="{x:Bind ViewModel.EditingSong.BitRate, Mode=OneWay, Converter={StaticResource VolumeToPercentConverter}}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            MaxLines="2"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.EditingSong.FilePath, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Right: Tabbed Structured Metadata Forms  -->
            <TabView Grid.Column="1" CloseButtonOverlayMode="OnPointerOver">
                <TabView.TabItems>

                    <!--  Tab 1: General Info  -->
                    <TabViewItem Header="General" IsClosable="False">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE8D2;" />
                        </TabViewItem.IconSource>
                        <ScrollViewer Padding="12,16">
                            <StackPanel
                                MaxWidth="680"
                                HorizontalAlignment="Left"
                                Spacing="16">
                                <TextBox
                                    Header="Title"
                                    PlaceholderText="Song Title"
                                    Text="{x:Bind ViewModel.EditingSong.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox
                                        Grid.Column="0"
                                        Header="Track Number"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.EditingSong.TrackNumber, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="1"
                                        Header="Total Tracks"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.EditingSong.TrackTotal, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox
                                        Grid.Column="0"
                                        Header="Disc Number"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.EditingSong.DiscNumber, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="1"
                                        Header="Total Discs"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.EditingSong.DiscTotal, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox
                                        Grid.Column="0"
                                        Header="Release Year"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.EditingSong.ReleaseYear, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="1"
                                        Header="Language"
                                        PlaceholderText="e.g. English, French"
                                        Text="{x:Bind ViewModel.EditingSong.Language, Mode=TwoWay}" />
                                </Grid>

                                <ToggleSwitch
                                    Header="Instrumental Track"
                                    IsOn="{x:Bind ViewModel.EditingSong.IsInstrumental, Mode=TwoWay}"
                                    OffContent="No (Vocal)"
                                    OnContent="Yes (Instrumental)" />

                                <TextBox
                                    MinHeight="80"
                                    AcceptsReturn="True"
                                    Header="Description / Commentary"
                                    Text="{x:Bind ViewModel.EditingSong.Description, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <!--  Tab 2: Artists & Credits  -->
                    <TabViewItem Header="Artists &amp; Credits" IsClosable="False">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE77B;" />
                        </TabViewItem.IconSource>
                        <ScrollViewer Padding="12,16">
                            <StackPanel
                                MaxWidth="680"
                                HorizontalAlignment="Left"
                                Spacing="16">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Linked Artists" />

                                <!--  Chip list of artists  -->
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.SelectedArtists, Mode=OneWay}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border
                                                Padding="10,4"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind}" />
                                                    <Button
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Command="{Binding ElementName=detailedImage, Path=DataContext.RemoveArtistCommand}"
                                                        CommandParameter="{x:Bind}">
                                                        <FontIcon FontSize="10" Glyph="&#xE711;" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <!--  Add Artist Input  -->
                                <AutoSuggestBox
                                    x:Name="ArtistSuggestBox"
                                    Header="Add Contributing Artist"
                                    ItemsSource="{x:Bind ViewModel.ArtistSuggestions, Mode=OneWay}"
                                    PlaceholderText="Search artists or enter new name..."
                                    QuerySubmitted="ArtistSuggestBox_QuerySubmitted"
                                    TextChanged="ArtistSuggestBox_TextChanged" />

                                <MenuFlyoutSeparator />

                                <TextBox
                                    Header="Composer"
                                    PlaceholderText="Composer name"
                                    Text="{x:Bind ViewModel.EditingSong.Composer, Mode=TwoWay}" />
                                <TextBox
                                    Header="Conductor"
                                    PlaceholderText="Conductor / Ensemble lead"
                                    Text="{x:Bind ViewModel.EditingSong.Conductor, Mode=TwoWay}" />
                                <TextBox
                                    Header="Lyricist"
                                    PlaceholderText="Songwriter / Lyricist"
                                    Text="{x:Bind ViewModel.EditingSong.Lyricist, Mode=TwoWay}" />
                                <NumberBox
                                    Header="Beats Per Minute (BPM)"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.EditingSong.BPM, Mode=TwoWay}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <!--  Tab 3: Album & Genre  -->
                    <TabViewItem Header="Album &amp; Genre" IsClosable="False">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE93C;" />
                        </TabViewItem.IconSource>
                        <ScrollViewer Padding="12,16">
                            <StackPanel
                                MaxWidth="680"
                                HorizontalAlignment="Left"
                                Spacing="16">
                                <TextBox
                                    Header="Album Title"
                                    PlaceholderText="Album Title"
                                    Text="{x:Bind ViewModel.EditingSong.AlbumName, Mode=TwoWay}" />
                                <TextBox
                                    Header="Genre"
                                    PlaceholderText="Genre (e.g. Pop, Synthwave)"
                                    Text="{x:Bind ViewModel.EditingSong.GenreName, Mode=TwoWay}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <!--  Tab 4: Lyrics & Notes  -->
                    <TabViewItem Header="Lyrics &amp; Notes" IsClosable="False">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE8BD;" />
                        </TabViewItem.IconSource>
                        <ScrollViewer Padding="12,16">
                            <StackPanel
                                MaxWidth="680"
                                HorizontalAlignment="Left"
                                Spacing="16">
                                <TextBox
                                    MinHeight="200"
                                    AcceptsReturn="True"
                                    Header="Unsynced Lyrics"
                                    PlaceholderText="Paste lyrics here..."
                                    Text="{x:Bind ViewModel.EditingSong.UnSyncLyrics, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                                <TextBox
                                    MinHeight="140"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    Header="Synchronized LRC Lyrics"
                                    PlaceholderText="[00:12.00] Line of lyrics..."
                                    Text="{x:Bind ViewModel.EditingSong.SyncLyrics, Mode=TwoWay}"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                    <!--  Tab 5: Online Match (Last.fm)  -->
                    <TabViewItem Header="Last.fm Match" IsClosable="False">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE753;" />
                        </TabViewItem.IconSource>
                        <ScrollViewer Padding="12,16">
                            <StackPanel
                                MaxWidth="680"
                                HorizontalAlignment="Left"
                                Spacing="16">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Query Last.fm for Metadata" />

                                <TextBox Header="Query Track Name" Text="{x:Bind ViewModel.OnlineSearchTitle, Mode=TwoWay}" />
                                <TextBox Header="Query Artist" Text="{x:Bind ViewModel.OnlineSearchArtist, Mode=TwoWay}" />

                                <Button
                                    Command="{x:Bind ViewModel.SearchOnlineCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsSearchingOnline, Mode=OneWay, Converter={StaticResource BoolToInverseVisibilityConverter}}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            IsActive="{x:Bind ViewModel.IsSearchingOnline, Mode=OneWay}" />
                                        <TextBlock Text="Search Last.fm" />
                                    </StackPanel>
                                </Button>

                                <!--  Online Result Panel  -->
                                <Border
                                    Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{x:Bind ViewModel.HasOnlineResults, Mode=OneWay}">
                                    <StackPanel Spacing="12">
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="Match Found" />
                                        <TextBlock
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="{Binding OnlineMetadataResult.Name, Mode=OneWay}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding OnlineMetadataResult.Artist.Name, Mode=OneWay}" />

                                        <Button
                                            Command="{x:Bind ViewModel.ApplyOnlineMetadataCommand}"
                                            Content="Merge into Song"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabViewItem>

                </TabView.TabItems>
            </TabView>
        </Grid>
    </Grid>
</UserControl>