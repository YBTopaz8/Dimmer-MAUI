<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Name="MyArtistPage"
    x:Class="Dimmer.WinUI.Views.WinuiPages.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Dimmer.Utilities.TypeConverters;assembly=Dimmer"
    xmlns:convertersWinUI="using:Dimmer.WinUI.Utils.Converters"
    xmlns:cw="using:Dimmer.WinUI.Views.WinuiPages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:devWin="using:DevWinUI"
    xmlns:dgView="using:WinUI.TableView"
    xmlns:dimmSearch="clr-namespace:Dimmer.Data.ModelView.DimmerSearch;assembly=Dimmer"
    xmlns:lang="clr-namespace:Dimmer.Resources.Localization;assembly=Dimmer"
    xmlns:local="using:Dimmer.WinUI.Views.WinuiPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:models="clr-namespace:Dimmer.Data.ModelView;assembly=Dimmer"
    xmlns:modelsDb="clr-namespace:Dimmer.Data.Models;assembly=Dimmer"
    xmlns:modeltwo="clr-namespace:Dimmer.WinUI.Utils.Models"
    xmlns:statsModels="clr-namespace:Dimmer.Charts;assembly=Dimmer"
    xmlns:statsVM="clr-namespace:Dimmer.ViewModel.StatsVMs;assembly=Dimmer"
    xmlns:tql="clr-namespace:Dimmer.DimmerSearch.TQL;assembly=Dimmer"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="clr-namespace:Dimmer.WinUI.ViewModel"
    PointerPressed="MyArtistPage_PointerPressed"
    mc:Ignorable="d">


    <Page.Resources>
        <!--  Reusable Style for Section Headers  -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="450" />
                <!--  Cinematic Hero Header  -->
                <RowDefinition Height="Auto" />
                <!--  Top Tracks & CoverFlow  -->
                <RowDefinition Height="Auto" />
                <!--  Albums Loop  -->
                <RowDefinition Height="Auto" />
                <!--  The "Last.fm" Dimmer Analytics  -->
            </Grid.RowDefinitions>

            <!--  =================================================================  -->
            <!--  1. CINEMATIC HERO HEADER (Spotify / Apple Music Style)  -->
            <!--  =================================================================  -->
            <Grid Grid.Row="0">
                <Image
                    x:Name="ArtistImg"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Loaded="ArtistImg_Loaded"
                    Source="{x:Bind MyViewModel.SelectedArtist.ImagePath, Mode=OneWay}"
                    Stretch="UniformToFill" />

                <!--  Rich Gradient Fade into background  -->
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Offset="0.0" Color="#33000000" />
                            <GradientStop Offset="0.6" Color="#BB000000" />
                            <GradientStop Offset="1.0" Color="{ThemeResource SolidBackgroundFillColorBase}" />
                        </LinearGradientBrush>
                    </Grid.Background>
                </Grid>

                <StackPanel
                    Padding="48,0,48,40"
                    VerticalAlignment="Bottom"
                    Spacing="16">
                    <!--  Verified / Rank Badge  -->
                    <Border
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource SystemAccentColor}"
                        CornerRadius="4">
                        <TextBlock
                            CharacterSpacing="50"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="VERIFIED DIMMER ARTIST" />
                    </Border>

                    <!--  Artist Name  -->
                    <TextBlock
                        Margin="0,-12,0,0"
                        FontSize="80"
                        FontWeight="Black"
                        Text="{x:Bind MyViewModel.SelectedArtist.Name, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <!--  Quick Actions  -->
                    <StackPanel
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        Spacing="16">
                        <Button
                            Height="56"
                            Padding="36,0"
                            CornerRadius="28"
                            Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="20" Glyph="&#xE768;" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Text="Play" />
                            </StackPanel>
                        </Button>
                        <Button
                            Width="56"
                            Height="56"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="28"
                            ToolTipService.ToolTip="Shuffle">
                            <FontIcon FontSize="20" Glyph="&#xE8B1;" />
                        </Button>
                        <Button
                            Width="56"
                            Height="56"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="28"
                            ToolTipService.ToolTip="Artist Radio">
                            <FontIcon FontSize="20" Glyph="&#xEC15;" />
                        </Button>
                        <ToggleButton
                            Width="56"
                            Height="56"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="28">
                            <FontIcon
                                FontSize="20"
                                Foreground="{ThemeResource SystemAccentColorLight2}"
                                Glyph="&#xEB51;" />
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--  =================================================================  -->
            <!--  2. TOP TRACKS & COVERFLOW (YouTube Music Style)  -->
            <!--  =================================================================  -->
            <Grid
                Grid.Row="1"
                Padding="48,32"
                ColumnSpacing="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <!--  Songs Table  -->
                    <ColumnDefinition Width="4*" />
                    <!--  CoverFlow / Visuals  -->
                </Grid.ColumnDefinitions>

                <!--  Left: Popular Songs Table  -->
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Popular Tracks" />

                    <Border
                        Padding="0,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <dgView:TableView
                            x:Name="ArtistSongsDG"
                            Height="360"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            CellDoubleTapped="ArtistSongsDG_CellDoubleTapped"
                            HeadersVisibility="None"
                            Loaded="ArtistSongsDG_Loaded"
                            RowHeight="52">
                            <dgView:TableView.Columns>
                                <!--  Clean Audio Format Badge  -->
                                <dgView:TableViewTemplateColumn Width="70">
                                    <dgView:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                                Padding="6,2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding FileFormat}" />
                                            </Border>
                                        </DataTemplate>
                                    </dgView:TableViewTemplateColumn.CellTemplate>
                                </dgView:TableViewTemplateColumn>

                                <!--  Title & Album  -->
                                <dgView:TableViewTemplateColumn Width="*">
                                    <dgView:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding AlbumName}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dgView:TableViewTemplateColumn.CellTemplate>
                                </dgView:TableViewTemplateColumn>

                                <!--  Dims (Plays) with Icon  -->
                                <dgView:TableViewTemplateColumn Width="100">
                                    <dgView:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                                <FontIcon
                                                    FontSize="12"
                                                    Foreground="{ThemeResource SystemAccentColor}"
                                                    Glyph="&#xE102;" />
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding PlayCompletedCount}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </dgView:TableViewTemplateColumn.CellTemplate>
                                </dgView:TableViewTemplateColumn>

                                <!--  Duration  -->
                                <dgView:TableViewTextColumn Width="80" Binding="{Binding DurationFormatted}" />
                            </dgView:TableView.Columns>
                        </dgView:TableView>
                    </Border>
                </StackPanel>

                <!--  Right: CoverFlow (Visual Showcase) & Bio  -->
                <StackPanel Grid.Column="1" Spacing="24">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Visualizer Showcase" />
                    <devWin:CoverFlow
                        x:Name="StoreCarouselTopSongs"
                        Height="220"
                        Loaded="StoreCarouselTopSongs_Loaded">
                        <devWin:CoverFlow.ItemTemplate>
                            <DataTemplate>
                                <Grid CornerRadius="12">
                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill" />
                                    <Border
                                        Padding="12,8"
                                        VerticalAlignment="Bottom"
                                        Background="#66000000">
                                        <TextBlock
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </devWin:CoverFlow.ItemTemplate>
                    </devWin:CoverFlow>

                    <!--  Compact Bio  -->
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <devWin:AutoScrollView MaxHeight="100">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                LineHeight="20"
                                Text="{x:Bind MyViewModel.SelectedArtist.Bio, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </devWin:AutoScrollView>
                    </Border>
                </StackPanel>
            </Grid>

            <!--  =================================================================  -->
            <!--  3. ALBUMS LOOP PANEL (Immersive Horizontal Scroll)  -->
            <!--  =================================================================  -->
            <StackPanel Grid.Row="2" Padding="48,0,0,32">
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Discography" />

                <ItemsControl x:Name="loopingList" ItemsSource="{x:Bind MyViewModel.SelectedArtist.AlbumsByArtist, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <devWin:LoopPanel
                                Background="Transparent"
                                BringChildrenIntoView="False"
                                IsInertiaEnabled="True"
                                Orientation="Horizontal"
                                Spacing="24" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--  Album Card  -->
                            <StackPanel Width="200" Spacing="12">
                                <Border
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Image
                                        Width="200"
                                        Height="200"
                                        Source="{Binding ImagePath}"
                                        Stretch="UniformToFill" />
                                </Border>
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  =================================================================  -->
            <!--  4. DIMMER DEEP ANALYTICS (The Last.fm Fusion)  -->
            <!--  =================================================================  -->
            <StackPanel
                Grid.Row="3"
                Padding="48,32"
                Background="{ThemeResource LayerFillColorAltBrush}">
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Your Dimmer Analytics" />

                <!--  4A. Macro Stats Dashboard  -->
                <Grid Margin="0,0,0,32" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <devWin:Card
                        Title="{x:Bind MyArtistStatsViewModel.TextBingeRecord.Title, Mode=OneWay}"
                        Grid.Column="0"
                        Content="{x:Bind MyArtistStatsViewModel.TextBingeRecord.Value, Mode=OneWay}"
                        TitleContent="{x:Bind MyArtistStatsViewModel.TextBingeRecord.Subtitle, Mode=OneWay}" />
                    <devWin:Card
                        Title="{x:Bind MyArtistStatsViewModel.TextTotalTime.Title, Mode=OneWay}"
                        Grid.Column="1"
                        Content="{x:Bind MyArtistStatsViewModel.TextTotalTime.Value, Mode=OneWay}"
                        TitleContent="{x:Bind MyArtistStatsViewModel.TextTotalTime.Subtitle, Mode=OneWay}" />
                    <devWin:Card
                        Title="{x:Bind MyArtistStatsViewModel.TextLoyaltyIndex.Title, Mode=OneWay}"
                        Grid.Column="2"
                        Content="{x:Bind MyArtistStatsViewModel.TextLoyaltyIndex.Value, Mode=OneWay}"
                        TitleContent="{x:Bind MyArtistStatsViewModel.TextLoyaltyIndex.Subtitle, Mode=OneWay}" />
                    <devWin:Card
                        Title="{x:Bind MyArtistStatsViewModel.TextYoYGrowth.Title, Mode=OneWay}"
                        Grid.Column="3"
                        Content="{x:Bind MyArtistStatsViewModel.TextYoYGrowth.Value, Mode=OneWay}"
                        TitleContent="{x:Bind MyArtistStatsViewModel.TextYoYGrowth.Subtitle, Mode=OneWay}" />
                    <devWin:Card
                        Title="{x:Bind MyArtistStatsViewModel.TextLifespan.Title, Mode=OneWay}"
                        Grid.Column="4"
                        Content="{x:Bind MyArtistStatsViewModel.TextLifespan.Value, Mode=OneWay}"
                        TitleContent="{x:Bind MyArtistStatsViewModel.TextLifespan.Subtitle, Mode=OneWay}" />
                </Grid>

                <!--  4B. Micro Stats Lists (Deep Cuts, Trends, Eras)  -->
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  DEEP CUTS (Hidden Gems)  -->
                    <StackPanel Grid.Column="0" Spacing="16">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Deep Cuts (Hidden Gems)" />
                        <ItemsRepeater x:Name="ListDeepCuts" Loaded="ListDeepCuts_Loaded">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="{ThemeResource SystemAccentColor}"
                                            Text="{Binding Rank}" />
                                        <devWin:ImageEx
                                            Grid.Column="1"
                                            Width="36"
                                            Height="36"
                                            Margin="0,0,12,0"
                                            CornerRadius="4"
                                            Source="{Binding ImagePath}"
                                            Stretch="UniformToFill" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding SubValue}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!--  MONTHLY TREND  -->
                    <StackPanel Grid.Column="1" Spacing="16">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Monthly Momentum" />
                        <ItemsRepeater x:Name="ListMonthlyTrend" Loaded="ListMonthlyTrend_Loaded">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Margin="0,0,0,8"
                                        Padding="16,12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Text="{Binding Period}" />
                                            <StackPanel
                                                Margin="0,4,0,0"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource SystemAccentColor}"
                                                    Text="{Binding PlayCount}" />
                                                <TextBlock
                                                    VerticalAlignment="Bottom"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Dims" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="12"
                                                Foreground="SeaGreen"
                                                Text="{Binding ChangeVsPrevious}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!--  ERA PREFERENCE  -->
                    <StackPanel Grid.Column="2" Spacing="16">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Era Preference" />
                        <ItemsRepeater x:Name="ListEraPreference" Loaded="ListEraPreference_Loaded">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Margin="0,0,0,8"
                                        Padding="16,12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Text="{Binding Period}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="{ThemeResource SystemAccentColor}"
                                                Text="{Binding PlayCount}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ChangeVsPrevious}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                    <!--  PLAY/SKIP RATIO  -->
                    <StackPanel Grid.Column="3" Spacing="16">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Play vs Skip Ratio" />
                        <ItemsRepeater x:Name="ListPlaySkipRatio" Loaded="ListPlaySkipRatio_Loaded">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Margin="0,0,0,8"
                                        Padding="16,12"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{Binding ColorHex}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                Text="{Binding Icon}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Text="{Binding Title}" />
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Description}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>

                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>