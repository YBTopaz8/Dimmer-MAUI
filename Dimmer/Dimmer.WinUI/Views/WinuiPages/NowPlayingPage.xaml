<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Dimmer.WinUI.Views.WinuiPages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Dimmer.WinUI.Utils.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:devWin="using:DevWinUI"
    xmlns:local="using:Dimmer.WinUI.Views.WinuiPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiviews="using:Dimmer.WinUI.Views.CustomViews.WinuiViews"
    mc:Ignorable="d"
    >
    <Page.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:RepeatModeConverter x:Key="RepeatModeConverter" />
            <converters:BoolToPlayingPauseConv x:Key="BoolToPlayingPauseConverter" />
            <converters:DurationConverterFromSecondsToTimeSpan x:Key="DurationConverterFromSecondsToTS" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>

        <Image
            x:Name="CurrentPlayingSongImgBG"
            Grid.Column="0"
            Stretch="UniformToFill"
            />
        <ScrollViewer x:Name="mainView" PointerPressed="MainView_PointerPressed">
            <StackPanel Padding="40" Spacing="8">
                <!--  Carousel Section  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>
                    <Image
                        x:Name="CurrentPlayingSongImg"
                        Grid.Column="0"
                        MaxWidth="350"
                        MaxHeight="350"
                        Canvas.ZIndex="1"
                        Loaded="CurrentPlayingSongImg_Loaded"
                        Loading="CurrentPlayingSongImg_Loading"
                        Stretch="UniformToFill"
                        />

                    <ListView
                        x:Name="SyncLyricsListView"
                        Grid.Column="0"
                        MaxHeight="290"
                        Margin="0,0,50,0"
                        HorizontalAlignment="Right"
                        ItemClick="SyncLyricsListView_ItemClick"
                        ItemsSource="{x:Bind MyViewModel.AllLines}"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        SelectedItem="{x:Bind MyViewModel.CurrentLine, Mode=OneWay}"
                        SelectionChanged="ListView_SelectionChanged"
                        SelectionMode="Single"
                        >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border>
                                    <TextBlock Text="{Binding Text}" />
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!--  Song Info  -->
                <StackPanel
                    x:Name="SongInfoStackPanel"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    >
                    <Button
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Background="Transparent"
                        Content="{x:Bind MyViewModel.CurrentPlayingSongView.Title, Mode=OneWay}"
                        CornerRadius="12"
                        FontSize="28"
                        FontWeight="SemiBold"
                        />
                    <Button
                        x:Name="CurrentArtistBtn"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Background="Transparent"
                        Click="CurrentArtistBtn_Click"
                        Content="{x:Bind MyViewModel.CurrentPlayingSongView.OtherArtistsName, Mode=OneWay}"
                        CornerRadius="12"
                        FontSize="18"
                        Opacity="0.8"
                        />
                    <Button
                        x:Name="ArtistBtn"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Background="Transparent"
                        Click="ArtistBtn_Click"
                        Content="{x:Bind MyViewModel.CurrentPlayingSongView.AlbumName, Mode=OneWay}"
                        CornerRadius="12"
                        FontSize="16"
                        Opacity="0.6"
                        />
                </StackPanel>

                <!--  Progress Section  -->
                <StackPanel Spacing="5">
                    <Slider
                        x:Name="ProgressSlider"
                        Foreground="DarkSlateBlue"
                        IsThumbToolTipEnabled="True"
                        Maximum="{x:Bind MyViewModel.CurrentTrackDurationSeconds, Mode=OneWay}"
                        Minimum="0"
                        
                        
                        Value="{x:Bind MyViewModel.CurrentTrackPositionSeconds, Mode=OneWay}"
                        />
                    <Grid>
                        <TextBlock
                            HorizontalAlignment="Left"
                            FontSize="12"
                            Text="{x:Bind MyViewModel.CurrentTrackPositionSeconds, Converter={StaticResource DurationConverterFromSecondsToTS}, Mode=OneWay}"
                            />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Text="{x:Bind MyViewModel.CurrentTrackDurationSeconds, Converter={StaticResource DurationConverterFromSecondsToTS}, Mode=OneWay}"
                            />
                    </Grid>
                </StackPanel>

                <!--  Playback Controls  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16"
                    >
                    <ToggleButton
                        Width="48"
                        Height="48"
                        Command="{x:Bind MyViewModel.ToggleShuffleCommand}"
                        IsChecked="{x:Bind MyViewModel.IsShuffleActive, Mode=OneWay}"
                        >
                        <FontIcon Glyph="&#xE8B1;" />
                    </ToggleButton>
                    <Button
                        Width="56"
                        Height="56"
                        Command="{x:Bind MyViewModel.PreviousTrackCommand}"
                        >
                        <Button.CommandParameter>
                            <x:Boolean>False</x:Boolean>
                        </Button.CommandParameter>
                        <FontIcon FontSize="20" Glyph="&#xE892;" />
                    </Button>
                    <ToggleButton
                        Width="72"
                        Height="72"
                        Command="{x:Bind MyViewModel.PlayPauseToggleCommand}"
                        Content="{x:Bind MyViewModel.IsDimmerPlaying, Converter={StaticResource BoolToPlayingPauseConverter}, Mode=OneWay}"
                        IsChecked="{x:Bind MyViewModel.IsDimmerPlaying, Mode=OneWay}"
                        />
                    <Button
                        Width="56"
                        Height="56"
                        Command="{x:Bind MyViewModel.NextTrackCommand}"
                        >
                        <Button.CommandParameter>
                            <x:Boolean>True</x:Boolean>
                        </Button.CommandParameter>
                        <FontIcon Glyph="&#xE893;" />
                    </Button>
                    <Button
                        Width="48"
                        Height="48"
                        Command="{x:Bind MyViewModel.ToggleRepeatModeCommand}"
                        Content="{x:Bind MyViewModel.CurrentRepeatMode, Converter={StaticResource RepeatModeConverter}, Mode=OneWay}"
                        />
                </StackPanel>

                <!--  Additional Actions  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12"
                    >
                    <Button
                        x:Name="ViewAllSongs"
                        Click="ViewAllSongs_Click"
                        Content="All Songs"
                        Style="{StaticResource SecondaryButtonStyle}"
                        />
                    <Button Content="Queue" Style="{StaticResource SecondaryButtonStyle}">
                        <Button.Flyout>
                            <Flyout>
                                <TextBlock Text="Queue functionality" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Audio FX" Style="{StaticResource SecondaryButtonStyle}">
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <StackPanel Width="320" Spacing="15" Padding="10">
                                    <TextBlock Text="Audio Tweaks" FontSize="18" FontWeight="SemiBold" />

                                    <!-- Playback Mode (Nightcore, Slowed, etc) -->
                                    <ComboBox Header="Playback Mode" 
                          HorizontalAlignment="Stretch"
                          SelectedIndex="{x:Bind MyViewModel.SelectedPlaybackModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Normal" />
                                        <ComboBoxItem Content="Nightcore (Fast &amp; High)" />
                                        <ComboBoxItem Content="Slowed (Clean)" />
                                        <ComboBoxItem Content="Slowed + Reverb" />
                                    </ComboBox>

                                    <MenuFlyoutSeparator />

                                    <!-- Enhancements -->
                                    <ToggleSwitch Header="Vocal Compressor" 
                              IsOn="{x:Bind MyViewModel.IsCompressorEnabled, Mode=TwoWay}" />

                                    <ToggleSwitch Header="Ambience (Rain)" 
                              IsOn="{x:Bind MyViewModel.IsAmbienceEnabled, Mode=TwoWay}" />

                                    <MenuFlyoutSeparator />

                                    <!-- 10-Band Equalizer (Mini Version) -->
                                    <TextBlock Text="10-Band Equalizer" FontWeight="SemiBold" />
                                    <ToggleSwitch IsOn="{x:Bind MyViewModel.IsEqEnabled, Mode=TwoWay}" OffContent="Off" OnContent="On" />

                                    <!-- Horizontal layout for EQ sliders -->
                                    <Grid Height="120"  >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Band 0 (Sub Bass) -->
                                        <Slider Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center" 
                            Minimum="-12" Maximum="12" Value="{x:Bind MyViewModel.EqBand0, Mode=TwoWay}" />
                                        <!-- Band 2 (Bass) -->
                                        <Slider Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" 
                            Minimum="-12" Maximum="12" Value="{x:Bind MyViewModel.EqBand2, Mode=TwoWay}" />
                                        <!-- Band 4 (Mids) -->
                                        <Slider Grid.Column="2" Orientation="Vertical" HorizontalAlignment="Center" 
                            Minimum="-12" Maximum="12" Value="{x:Bind MyViewModel.EqBand4, Mode=TwoWay}" />
                                        <!-- Band 7 (Treble) -->
                                        <Slider Grid.Column="3" Orientation="Vertical" HorizontalAlignment="Center" 
                            Minimum="-12" Maximum="12" Value="{x:Bind MyViewModel.EqBand7, Mode=TwoWay}"  />
                                        <!-- Band 9 (Air) -->
                                        <Slider Grid.Column="4" Orientation="Vertical" HorizontalAlignment="Center" 
                            Minimum="-12" Maximum="12" Value="{x:Bind MyViewModel.EqBand9, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="31Hz" FontSize="10" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="125Hz" FontSize="10" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="500Hz" FontSize="10" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="4kHz" FontSize="10" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="16kHz" FontSize="10" HorizontalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        Click="ViewSongDetailsButton_Click"
                        Content="Details"
                        Style="{StaticResource SecondaryButtonStyle}"
                        />


                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
