<?xml version="1.0" encoding="utf-8" ?>

<Page
    x:Class="Dimmer.WinUI.Views.WinuiPages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Dimmer.WinUI.Utils.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Dimmer.Data.ModelView"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:RepeatModeConverter x:Key="RepeatModeConverter" />
            <converters:BoolToPlayingPauseConv x:Key="BoolToPlayingPauseConverter" />
            <converters:DurationConverterFromSecondsToTimeSpan x:Key="DurationConverterFromSecondsToTS" />

            <!--  Custom Style for EQ Sliders  -->
            <Style x:Key="EqSliderStyle" TargetType="Slider">
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="Minimum" Value="-12" />
                <Setter Property="Maximum" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Height" Value="150" />
                <Setter Property="Margin" Value="0,5,0,5" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <!--  Background Blur  -->
        <Image
            x:Name="CurrentPlayingSongImgBG"
            Opacity="0.4"
            Stretch="UniformToFill" />
        <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.75" />

        <!--  Split Screen Layout: Left = Player, Right = Audio Engine  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!--  The Player  -->
                <ColumnDefinition Width="450" />
                <!--  The Audio Control Center  -->
            </Grid.ColumnDefinitions>

            <!--  ==========================================  -->
            <!--  LEFT COLUMN: TRADITIONAL NOW PLAYING  -->
            <!--  ==========================================  -->
            <ScrollViewer
                x:Name="mainView"
                Grid.Column="0"
                PointerPressed="MainView_PointerPressed">
                <StackPanel
                    Padding="40"
                    VerticalAlignment="Center"
                    Spacing="20">

                    <!--  Album Art & Lyrics  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            x:Name="CurrentPlayingSongImg"
                            Grid.Column="0"
                            MaxWidth="400"
                            MaxHeight="400"
                            Canvas.ZIndex="1"
                            Loaded="CurrentPlayingSongImg_Loaded"
                            Loading="CurrentPlayingSongImg_Loading"
                            Stretch="UniformToFill" />

                        <ListView
                            x:Name="SyncLyricsListView"
                            Grid.Column="0"
                            MaxHeight="350"
                            Margin="0,0,50,0"
                            HorizontalAlignment="Right"
                            ItemClick="SyncLyricsListView_ItemClick"
                            ItemsSource="{x:Bind MyViewModel.AllLines}"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            SelectedItem="{x:Bind MyViewModel.CurrentLine, Mode=OneWay}"
                            SelectionChanged="ListView_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="{Binding Text}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!--  Song Info  -->
                    <StackPanel
                        x:Name="SongInfoStackPanel"
                        HorizontalAlignment="Center"
                        Spacing="5">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="32"
                            FontWeight="Bold"
                            Text="{x:Bind MyViewModel.CurrentPlayingSongView.Title, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                        <Button
                            x:Name="CurrentArtistBtn"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CurrentArtistBtn_Click"
                            Content="{x:Bind MyViewModel.CurrentPlayingSongView.OtherArtistsName, Mode=OneWay}"
                            FontSize="20"
                            Opacity="0.8" />
                        <Button
                            x:Name="ArtistBtn"
                            HorizontalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ArtistBtn_Click"
                            Content="{x:Bind MyViewModel.CurrentPlayingSongView.AlbumName, Mode=OneWay}"
                            FontSize="16"
                            Opacity="0.6" />
                    </StackPanel>

                    <!--  Progress Bar  -->
                    <StackPanel
                        MaxWidth="600"
                        HorizontalAlignment="Stretch"
                        Spacing="5">
                        <Slider
                            x:Name="ProgressSlider"
                            Foreground="DarkSlateBlue"
                            IsThumbToolTipEnabled="True"
                            Maximum="{x:Bind MyViewModel.CurrentTrackDurationSeconds, Mode=OneWay}"
                            Minimum="0"
                            Value="{x:Bind MyViewModel.CurrentTrackPositionSeconds, Mode=OneWay}" />
                        <Grid>
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontSize="14"
                                Opacity="0.7"
                                Text="{x:Bind MyViewModel.CurrentTrackPositionSeconds, Converter={StaticResource DurationConverterFromSecondsToTS}, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="14"
                                Opacity="0.7"
                                Text="{x:Bind MyViewModel.CurrentTrackDurationSeconds, Converter={StaticResource DurationConverterFromSecondsToTS}, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <!--  Playback Controls  -->
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="20">
                        <ToggleButton
                            Width="50"
                            Height="50"
                            Command="{x:Bind MyViewModel.ToggleShuffleCommand}"
                            CornerRadius="25"
                            IsChecked="{x:Bind MyViewModel.IsShuffleActive, Mode=OneWay}">
                            <FontIcon Glyph="&#xE8B1;" />
                        </ToggleButton>
                        <Button
                            Width="60"
                            Height="60"
                            Command="{x:Bind MyViewModel.PreviousTrackCommand}"
                            CornerRadius="30">
                            <FontIcon FontSize="22" Glyph="&#xE892;" />
                        </Button>
                        <ToggleButton
                            Width="80"
                            Height="80"
                            Background="DarkSlateBlue"
                            Command="{x:Bind MyViewModel.PlayPauseToggleCommand}"
                            Content="{x:Bind MyViewModel.IsDimmerPlaying, Converter={StaticResource BoolToPlayingPauseConverter}, Mode=OneWay}"
                            CornerRadius="40"
                            Foreground="White"
                            IsChecked="{x:Bind MyViewModel.IsDimmerPlaying, Mode=OneWay}" />
                        <Button
                            Width="60"
                            Height="60"
                            Command="{x:Bind MyViewModel.NextTrackCommand}"
                            CornerRadius="30">
                            <FontIcon FontSize="22" Glyph="&#xE893;" />
                        </Button>
                        <Button
                            Width="50"
                            Height="50"
                            Command="{x:Bind MyViewModel.ToggleRepeatModeCommand}"
                            Content="{x:Bind MyViewModel.CurrentRepeatMode, Converter={StaticResource RepeatModeConverter}, Mode=OneWay}"
                            CornerRadius="25" />
                    </StackPanel>

                    <!--  Standard Actions  -->
                    <StackPanel
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="15">
                        <Button
                            Click="ViewAllSongs_Click"
                            Content="Library"
                            Style="{StaticResource SecondaryButtonStyle}" />
                        <Button
                            Click="ViewSongDetailsButton_Click"
                            Content="Details"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!--  ==========================================  -->
            <!--  RIGHT COLUMN: AUDIO CONTROL CENTER  -->
            <!--  ==========================================  -->
            <Border
                Grid.Column="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="15">

                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="24"
                            FontWeight="Bold"
                            Text="Audio Engine" />

                        <!--  1. METERS & VISUALIZER  -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            Header="Visualizer &amp; VU Meters"
                            IsExpanded="True">
                            <StackPanel Padding="10" Spacing="10">
                                <ToggleSwitch Header="Enable Spectrum Analyzer" IsOn="{x:Bind MyViewModel.IsVisualizerEnabled, Mode=TwoWay}" />
                                <!--  Placeholder for your DevExpress Chart / Skia Canvas  -->
                                <Border
                                    Height="100"
                                    Background="#111"
                                    CornerRadius="8">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="SpringGreen"
                                        Text="[ Spectrum Visualizer ]"
                                        Visibility="{x:Bind MyViewModel.IsVisualizerEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Border>

                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontWeight="SemiBold"
                                    Text="Master Output Levels" />
                                <Grid ColumnDefinitions="Auto, *, Auto" RowSpacing="10">
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="L" />
                                    <ProgressBar
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="SpringGreen"
                                        Maximum="1"
                                        Value="{x:Bind MyViewModel.LeftVuLevel, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Width="50"
                                        Margin="10,0,0,0"
                                        Text="{x:Bind MyViewModel.LeftVuDb, Mode=OneWay}"
                                        TextAlignment="Right" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="R" />
                                    <ProgressBar
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="SpringGreen"
                                        Maximum="1"
                                        Value="{x:Bind MyViewModel.RightVuLevel, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Width="50"
                                        Margin="10,0,0,0"
                                        Text="{x:Bind MyViewModel.RightVuDb, Mode=OneWay}"
                                        TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!--  2. MASTER FX & VIBES  -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            Header="Master FX &amp; Modes"
                            IsExpanded="True">
                            <StackPanel Padding="10" Spacing="15">
                                <TextBlock FontWeight="SemiBold" Text="Vibe Modes" />
                                <RadioButtons SelectedIndex="{x:Bind MyViewModel.SelectedPlaybackModeIndex, Mode=TwoWay}">
                                    <RadioButton Content="Normal" />
                                    <RadioButton Content="Nightcore (Fast &amp; High)" />
                                    <RadioButton Content="Slowed (Clean)" />
                                    <RadioButton Content="Slowed + Reverb" />
                                </RadioButtons>

                                <MenuFlyoutSeparator Margin="0,5" />

                                <TextBlock FontWeight="SemiBold" Text="Studio Polish" />
                                <ToggleSwitch Header="Smart Master (Hi-Fi)" IsOn="{x:Bind MyViewModel.IsSmartMasterEnabled, Mode=TwoWay}" />
                                <ToggleSwitch Header="Vocal Compressor" IsOn="{x:Bind MyViewModel.IsCompressorEnabled, Mode=TwoWay}" />

                                <MenuFlyoutSeparator Margin="0,5" />

                                <Button
                                    HorizontalAlignment="Stretch"
                                    Background="DarkSlateBlue"
                                    Command="{x:Bind MyViewModel.ExportRemixCommand}"
                                    Content="Export Remix to WAV"
                                    Foreground="White" />
                            </StackPanel>
                        </Expander>

                        <!--  3. 10-BAND EQUALIZER  -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            Header="10-Band Graphic Equalizer"
                            IsExpanded="False">
                            <StackPanel Padding="10" Spacing="10">
                                <ToggleSwitch Header="Enable Equalizer" IsOn="{x:Bind MyViewModel.IsEqEnabled, Mode=TwoWay}" />

                                <Grid Loaded="Grid_Loaded">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Sliders  -->
                                    <Slider
                                        Grid.Column="0"
                                        Style="{StaticResource EqSliderStyle}"
                                        Value="{x:Bind MyViewModel.EqBand0, Mode=TwoWay}" />
                                    <Slider
                                        Grid.Column="1"
                                        Style="{StaticResource EqSliderStyle}"
                                        Value="{x:Bind MyViewModel.EqBand1, Mode=TwoWay}" />
                                    <Slider
                                        Grid.Column="2"
                                        Style="{StaticResource EqSliderStyle}"
                                        Value="{x:Bind MyViewModel.EqBand2, Mode=TwoWay}" />
                                    <Slider
                                        Grid.Column="3"
                                        Style="{StaticResource EqSliderStyle}"
                                        Value="{x:Bind MyViewModel.EqBand3, Mode=TwoWay}" />
                                    <Slider
                                        Grid.Column="4"
                                        Style="{StaticResource EqSliderStyle}"
                                        Value="{x:Bind MyViewModel.EqBand4, Mode=TwoWay}" />
                                    <Slider
                                        Grid.Column="5"
                                        Style="{StaticResource EqSliderStyle}"
                                        Value="{x:Bind MyViewModel.EqBand5, Mode=TwoWay}" />
                                    <Slider
                                        Grid.Column="6"
                                        Style="{StaticResource EqSliderStyle}"
                                        Value="{x:Bind MyViewModel.EqBand6, Mode=TwoWay}" />
                                    <Slider
                                        Grid.Column="7"
                                        Style="{StaticResource EqSliderStyle}"
                                        Value="{x:Bind MyViewModel.EqBand7, Mode=TwoWay}" />
                                    <Slider
                                        Grid.Column="8"
                                        Style="{StaticResource EqSliderStyle}"
                                        Value="{x:Bind MyViewModel.EqBand8, Mode=TwoWay}" />
                                    <Slider
                                        Grid.Column="9"
                                        Style="{StaticResource EqSliderStyle}"
                                        Value="{x:Bind MyViewModel.EqBand9, Mode=TwoWay}" />

                                    <!--  Labels  -->
                                    <TextBlock
                                        Grid.Column="0"
                                        Margin="0,160,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="31" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="0,160,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="62" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="0,160,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="125" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Margin="0,160,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="250" />
                                    <TextBlock
                                        Grid.Column="4"
                                        Margin="0,160,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="500" />
                                    <TextBlock
                                        Grid.Column="5"
                                        Margin="0,160,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="1k" />
                                    <TextBlock
                                        Grid.Column="6"
                                        Margin="0,160,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="2k" />
                                    <TextBlock
                                        Grid.Column="7"
                                        Margin="0,160,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="4k" />
                                    <TextBlock
                                        Grid.Column="8"
                                        Margin="0,160,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="8k" />
                                    <TextBlock
                                        Grid.Column="9"
                                        Margin="0,160,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="10"
                                        Foreground="Gray"
                                        Text="16k" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!--  4. AMBIENCE & DJ CROSSFADER  -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            Header="Ambience &amp; DJ Mixer"
                            IsExpanded="False">
                            <StackPanel Padding="10" Spacing="15">
                                <TextBlock FontWeight="SemiBold" Text="Study Mode (Background Noise)" />
                                <ToggleSwitch Header="Enable Ambience (Rain/Vinyl)" IsOn="{x:Bind MyViewModel.IsAmbienceEnabled, Mode=TwoWay}" />
                                <Slider
                                    Header="Ambience Volume"
                                    IsEnabled="{x:Bind MyViewModel.IsAmbienceEnabled, Mode=OneWay}"
                                    Maximum="1"
                                    Minimum="0"
                                    StepFrequency="0.05"
                                    Value="{x:Bind MyViewModel.AmbienceVolume, Mode=TwoWay}" />

                                <MenuFlyoutSeparator Margin="0,5" />

                                <TextBlock FontWeight="SemiBold" Text="DJ Crossfader" />
                                <Slider
                                    Maximum="1"
                                    Minimum="0"
                                    StepFrequency="0.01"
                                    Value="{x:Bind MyViewModel.CrossfadeBalance, Mode=TwoWay}" />
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="Track A" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="Track B" />
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <!--  5. HARDWARE ROUTING  -->
                        <Expander
                            HorizontalAlignment="Stretch"
                            Header="Routing &amp; Output"
                            IsExpanded="False">
                            <StackPanel Padding="10" Spacing="15">
                                <Slider
                                    Header="Master Volume"
                                    Maximum="1"
                                    Minimum="0"
                                    StepFrequency="0.01"
                                    Value="{x:Bind MyViewModel.DeviceVolumeLevel, Mode=TwoWay}" />

                                <Grid>
                                    <TextBlock VerticalAlignment="Center" Text="Output Device" />
                                    <Button
                                        Padding="5"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        Command="{x:Bind MyViewModel.LoadAllAudioDevicesCommand}">
                                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                        <!--  Refresh Icon  -->
                                    </Button>
                                </Grid>

                                <!--  ComboBox for Device Selection  -->
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind MyViewModel.AvailableDevices}"
                                    SelectedItem="{x:Bind MyViewModel.SelectedAudioDevice, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AudioOutputDevice">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <FontIcon FontSize="14" Glyph="&#xE7F5;" />
                                                <!--  Speaker Icon  -->
                                                <TextBlock Text="{x:Bind Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>


