<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="myPage"
    x:Class="Dimmer.Views.SingleSong.DetailsOverview"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:Dimmer.Utilities.TypeConverters;assembly=Dimmer"
    xmlns:dx="http://schemas.devexpress.com/maui"
    xmlns:globalVM="clr-namespace:Dimmer.ViewModel;assembly=Dimmer"
    xmlns:local="clr-namespace:Dimmer.Views.CustomViews"
    xmlns:lyrModels="clr-namespace:Dimmer.Data.Models.LyricsModels;assembly=Dimmer"
    xmlns:models="clr-namespace:Dimmer.Data.ModelView;assembly=Dimmer"
    xmlns:statsModels="clr-namespace:Dimmer.Charts;assembly=Dimmer"
    xmlns:statsVM="clr-namespace:Dimmer.ViewModel.StatsVMs;assembly=Dimmer"
    xmlns:vm="clr-namespace:Dimmer.ViewModels"
    Padding="5"
    x:DataType="models:SongModelView"
    BackgroundColor="{AppThemeBinding Dark=#121216,
                                      Light=#F8F9FA}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>

            <conv:BoolToInverseConverter x:Key="BoolToInverseConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid
        Padding="14,12,14,0"
        RowDefinitions="Auto,*"
        RowSpacing="10">

        <!--  ==========================================================  -->
        <!--  1. HERO HEADER (Cover Art + Title + Quick Actions)  -->
        <!--  ==========================================================  -->
        <dx:DXBorder
            Grid.Row="0"
            Padding="14"
            BackgroundColor="{AppThemeBinding Dark=#1A1A24,
                                              Light=#FFFFFF}"
            BorderColor="{AppThemeBinding Dark=#262636,
                                          Light=#EAEAEA}"
            BorderThickness="1"
            CornerRadius="20">

            <Grid
                ColumnDefinitions="110,*"
                ColumnSpacing="14"
                VerticalOptions="Center">
                <!--  Cover Art with Rounded Corners  -->
                <dx:DXBorder
                    Grid.Column="0"
                    BorderColor="{AppThemeBinding Dark=#333344,
                                                  Light=#DDDDDD}"
                    BorderThickness="1"
                    CornerRadius="16"
                    HeightRequest="110"
                    WidthRequest="110">
                    <dx:DXImage Aspect="AspectFill" Source="{Binding CoverImagePath}" />
                </dx:DXBorder>

                <!--  Track Details & Badges  -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="4"
                    VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="19"
                        LineBreakMode="TailTruncation"
                        MaxLines="2"
                        Text="{Binding Title}"
                        TextColor="{AppThemeBinding Dark=White,
                                                    Light=Black}" />

                    <!--  Artist Name Chip  -->
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        LineBreakMode="TailTruncation"
                        Text="{Binding OtherArtistsName}"
                        TextColor="DarkSlateBlue" />

                    <!--  Album & Year  -->
                    <HorizontalStackLayout Opacity="0.75" Spacing="6">
                        <Label
                            FontSize="12"
                            LineBreakMode="TailTruncation"
                            Text="{Binding AlbumName}" />
                        <Label
                            FontSize="10"
                            Text="•"
                            VerticalOptions="Center" />
                        <Label FontSize="12" Text="{Binding ReleaseYear}" />
                    </HorizontalStackLayout>

                    <!--  Stat Pills (Plays & Completion)  -->
                    <HorizontalStackLayout Margin="0,4,0,0" Spacing="8">
                        <dx:DXBorder
                            Padding="8,2"
                            BackgroundColor="{AppThemeBinding Dark=#2A2A3E,
                                                              Light=#EFEFF8}"
                            CornerRadius="8">
                            <Label
                                FontAttributes="Bold"
                                FontSize="11"
                                Text="{Binding PlayCompletedCount, StringFormat='▶ {0} dims'}"
                                TextColor="DarkSlateBlue" />
                        </dx:DXBorder>

                        <dx:DXBorder
                            Padding="8,2"
                            BackgroundColor="{AppThemeBinding Dark=#2A2A3E,
                                                              Light=#EFEFF8}"
                            CornerRadius="8">
                            <Label
                                FontSize="11"
                                Text="{Binding DurationFormatted}"
                                TextColor="{AppThemeBinding Dark=White,
                                                            Light=Black}" />
                        </dx:DXBorder>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </dx:DXBorder>

        <!--  ==========================================================  -->
        <!--  2. HIGH-PERFORMANCE SEGMENTED TAB VIEW  -->
        <!--  ==========================================================  -->
        <dx:TabView
            Grid.Row="1"
            BackgroundColor="Transparent"
            HeaderPanelPosition="Top"
            ItemHeaderTextColor="{AppThemeBinding Dark=#888888,
                                                  Light=#666666}"
            SelectedItemHeaderTextColor="DarkSlateBlue">

            <!--  TAB 1: TECH INFO & AUDIO SPECS  -->
            <dx:TabViewItem HeaderText="Audio Specs">
                <dx:DXScrollView Margin="0,10,0,0">
                    <VerticalStackLayout Spacing="10">
                        <dx:DXBorder
                            Padding="16"
                            BackgroundColor="{AppThemeBinding Dark=#1A1A24,
                                                              Light=#FFFFFF}"
                            BorderColor="{AppThemeBinding Dark=#262636,
                                                          Light=#EAEAEA}"
                            BorderThickness="1"
                            CornerRadius="16">

                            <Grid
                                ColumnDefinitions="*,*"
                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                RowSpacing="12">
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Opacity="0.6"
                                    Text="Bitrate" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalOptions="End"
                                    Text="{Binding BitRate, StringFormat='{0} kbps'}" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Opacity="0.6"
                                    Text="Sample Rate" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalOptions="End"
                                    Text="{Binding SampleRate, StringFormat='{0} Hz'}" />

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Opacity="0.6"
                                    Text="Format" />
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalOptions="End"
                                    Text="{Binding FileFormat}" />

                                <Label
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Opacity="0.6"
                                    Text="Track / Disc" />
                                <Label
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalOptions="End"
                                    Text="{Binding TrackNumber, StringFormat='Trk {0}'}" />

                                <Label
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Opacity="0.6"
                                    Text="File Size" />
                                <Label
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalOptions="End"
                                    Text="{Binding FileSize, StringFormat='{0:F2} MB'}" />

                                <Label
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Opacity="0.6"
                                    Text="Date Added" />
                                <Label
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    HorizontalOptions="End"
                                    Text="{Binding DateCreated, StringFormat='{0:MMM dd, yyyy}'}" />
                            </Grid>
                        </dx:DXBorder>

                        <!--  File Path Card  -->
                        <dx:DXBorder
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Dark=#1A1A24,
                                                              Light=#FFFFFF}"
                            BorderColor="{AppThemeBinding Dark=#262636,
                                                          Light=#EAEAEA}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <VerticalStackLayout Spacing="4">
                                <Label
                                    FontSize="11"
                                    Opacity="0.5"
                                    Text="File Path" />
                                <Label
                                    FontSize="12"
                                    LineBreakMode="CharacterWrap"
                                    Text="{Binding FilePath}" />
                            </VerticalStackLayout>
                        </dx:DXBorder>
                    </VerticalStackLayout>
                </dx:DXScrollView>
            </dx:TabViewItem>

            <!--  TAB 2: ANALYTICS & TRENDS  -->
            <dx:TabViewItem HeaderText="Analytics">
                <dx:DXScrollView x:Name="StatsScrollView" Margin="0,10,0,0">
                    <VerticalStackLayout Padding="0,0,0,20" Spacing="14">

                        <!--  Weekly Trends Carousel  -->
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="WEEKLY LISTENING TRENDS"
                            TextColor="DarkSlateBlue" />
                        <dx:DXCollectionView
                            HeightRequest="120"
                            ItemSpacing="10"
                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=StatsViewModel.ListWeeklyTrend}"
                            Orientation="Horizontal">
                            <dx:DXCollectionView.ItemTemplate>
                                <DataTemplate x:DataType="statsModels:TrendStat">
                                    <dx:DXBorder
                                        Padding="12"
                                        BackgroundColor="{AppThemeBinding Dark=#1A1A24,
                                                                          Light=#FFFFFF}"
                                        BorderColor="{AppThemeBinding Dark=#2A2A3A,
                                                                      Light=#E0E0E0}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        WidthRequest="140">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label
                                                FontSize="12"
                                                Opacity="0.6"
                                                Text="{Binding Period}" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                Text="{Binding PlayCount, StringFormat='{0} plays'}" />
                                            <Label
                                                FontSize="11"
                                                Text="{Binding ChangeVsPrevious, StringFormat='{0:+0;-0;0} vs prev'}"
                                                TextColor="Orange" />
                                        </VerticalStackLayout>
                                    </dx:DXBorder>
                                </DataTemplate>
                            </dx:DXCollectionView.ItemTemplate>
                        </dx:DXCollectionView>

                        <!--  Frequently Played Next Section  -->
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="FREQUENTLY PLAYED NEXT"
                            TextColor="DarkSlateBlue" />
                        <dx:DXCollectionView
                            HeightRequest="100"
                            ItemSpacing="10"
                            ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=StatsViewModel.ListPerfectPairings}"
                            Orientation="Horizontal">
                            <dx:DXCollectionView.ItemTemplate>
                                <DataTemplate x:DataType="statsModels:SongPairing">
                                    <dx:DXBorder
                                        Padding="10"
                                        BackgroundColor="{AppThemeBinding Dark=#1A1A24,
                                                                          Light=#FFFFFF}"
                                        BorderColor="{AppThemeBinding Dark=#2A2A3A,
                                                                      Light=#E0E0E0}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        WidthRequest="220">
                                        <Grid
                                            ColumnDefinitions="45,*"
                                            ColumnSpacing="10"
                                            VerticalOptions="Center">
                                            <dx:DXImage
                                                Grid.Column="0"
                                                Aspect="AspectFill"
                                                HeightRequest="45"
                                                Source="{Binding CoverImagePath}"
                                                WidthRequest="45" />
                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="2"
                                                VerticalOptions="Center">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    LineBreakMode="TailTruncation"
                                                    Text="{Binding PairedSongTitle}" />
                                                <Label
                                                    FontSize="11"
                                                    Opacity="0.6"
                                                    Text="{Binding TimesPlayedTogether, StringFormat='{0} times paired'}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </dx:DXBorder>
                                </DataTemplate>
                            </dx:DXCollectionView.ItemTemplate>
                        </dx:DXCollectionView>
                    </VerticalStackLayout>
                </dx:DXScrollView>
            </dx:TabViewItem>

            <!--  TAB 3: LYRICS  -->
            <dx:TabViewItem HeaderText="Lyrics">
                <Grid Margin="0,10,0,0" RowDefinitions="Auto,*">
                    <HorizontalStackLayout
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        HorizontalOptions="End"
                        Spacing="10">
                        <dx:DXButton
                            Padding="12,0"
                            Clicked="EditLyrics_Clicked"
                            Content="Edit Lyrics"
                            CornerRadius="16"
                            FontSize="12"
                            HeightRequest="32" />
                    </HorizontalStackLayout>

                    <dx:DXBorder
                        Grid.Row="1"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Dark=#1A1A24,
                                                          Light=#FFFFFF}"
                        CornerRadius="16">
                        <dx:DXScrollView>
                            <Label
                                FontSize="15"
                                LineHeight="1.5"
                                Text="{Binding SyncLyrics, TargetNullValue='No synced lyrics available for this song.'}" />
                        </dx:DXScrollView>
                    </dx:DXBorder>
                </Grid>
            </dx:TabViewItem>
        </dx:TabView>
    </Grid>




</ContentPage>