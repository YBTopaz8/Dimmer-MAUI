<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Name="NowPlayingBtmSheet"
    x:Class="Dimmer.Views.CustomViews.NowPlayingView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Dimmer.Utilities.TypeConverters;assembly=Dimmer"
    xmlns:dx="http://schemas.devexpress.com/maui"
    xmlns:localBehv="clr-namespace:Dimmer.Utils.Behaviors"
    xmlns:models="clr-namespace:Dimmer.Data.ModelView;assembly=Dimmer"
    xmlns:statsModels="clr-namespace:Dimmer.Charts;assembly=Dimmer"
    xmlns:statsVM="clr-namespace:Dimmer.ViewModel.StatsVMs;assembly=Dimmer"
    xmlns:vm="clr-namespace:Dimmer.ViewModels"
    x:DataType="vm:BaseViewModelAnd"
    Unloaded="myPage_Unloaded">



    <Grid RowDefinitions="*">
        <Grid.Resources>
            <ResourceDictionary>
                <Style TargetType="dx:DXButton">
                    <Setter Property="HeightRequest" Value="50" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <dx:DXImage
            x:Name="MainBgImg"
            Grid.RowSpan="2"
            Aspect="AspectFill"
            Opacity="0.4"
            Source="{Binding CurrentPlayingSongView.CoverImagePath}" />

        <dx:DXBorder
            Grid.RowSpan="2"
            BackgroundColor="Black"
            Opacity="0.45" />

        <dx:DXExpander x:Name="SyncLyricsView" IsExpanded="False">

            <Grid RowDefinitions="auto,*">
                <dx:DXStackLayout Grid.Row="0">

                    <dx:DXButton
                        x:Name="NowPlayingHighlightBtn"
                        Padding="5"
                        HorizontalContentAlignment="Fill"
                        BackgroundColor="Transparent"
                        CornerRadius="10"
                        HeightRequest="100"
                        IsVisible="True"
                        PressedBackgroundColor="{Binding CurrentPlaySongDominantColor}"
                        TapPressed="NowPlayingHighlightBtn_TapPressed">

                        <Grid
                            Padding="0"
                            BackgroundColor="Transparent"
                            ColumnDefinitions="auto, *">
                            <dx:DXBorder
                                Grid.ColumnSpan="2"
                                BackgroundColor="{Binding CurrentPlaySongDominantColor}"
                                CornerRadius="10"
                                Opacity="0.8" />
                            <dx:DXImage
                                Grid.Column="0"
                                Margin="5,0"
                                Aspect="AspectFit"
                                MaximumHeightRequest="60"
                                MaximumWidthRequest="60"
                                Source="{Binding CurrentPlayingSongView.CoverImagePath}"
                                VerticalOptions="Start" />

                            <dx:DXStackLayout
                                Grid.Column="1"
                                Margin="0,5"
                                BackgroundColor="Transparent"
                                VerticalOptions="Start">
                                <dx:DXStackLayout.Resources>
                                    <ResourceDictionary>
                                        <Style TargetType="Label">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=White}" />
                                        </Style>
                                    </ResourceDictionary>
                                </dx:DXStackLayout.Resources>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    Text="{Binding CurrentPlayingSongView.Title}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
                                    <Label
                                        Grid.Column="0"
                                        FontSize="13"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding CurrentPlayingSongView.OtherArtistsName}" />

                                    <Label
                                        Grid.Column="1"
                                        FontSize="13"
                                        LineBreakMode="WordWrap"
                                        Text="{Binding CurrentPlayingSongView.AlbumName}" />

                                </Grid>
                            </dx:DXStackLayout>



                        </Grid>
                    </dx:DXButton>
                </dx:DXStackLayout>
                <dx:DXCollectionView
                    x:Name="AllLyricsCV"
                    Grid.Row="1"
                    Margin="5"
                    ItemsSource="{Binding AllLines}"
                    SelectedItem="{Binding CurrentLine}"
                    SelectionChanged="AllLyricsCV_SelectionChanged"
                    SelectionMode="Single"
                    Tap="AllLyricsCV_Tap">
                    <dx:DXCollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:LyricPhraseModelView">
                            <Label FontSize="19" Text="{Binding Text}" />
                        </DataTemplate>
                    </dx:DXCollectionView.ItemTemplate>

                    <dx:DXCollectionView.SelectedItemTemplate>
                        <DataTemplate x:DataType="models:LyricPhraseModelView">


                            <Grid
                                x:Name="CurrentLineBtn"
                                BackgroundColor="Transparent"
                                ColumnDefinitions="*">
                                <dx:DXBorder
                                    Margin="1"
                                    BackgroundColor="Black"
                                    CornerRadius="0"
                                    Opacity="0.6" />

                                <Label
                                    Margin="1"
                                    FontSize="28"
                                    Text="{Binding Text}"
                                    TextColor="DarkSlateBlue" />

                            </Grid>
                        </DataTemplate>
                    </dx:DXCollectionView.SelectedItemTemplate>
                </dx:DXCollectionView>
            </Grid>
        </dx:DXExpander>

        <dx:DXExpander x:Name="NowPlayingViewExpander" VerticalOptions="End">

            <Grid
                Grid.Row="0"
                Margin="0,0"
                Padding="0,0"
                BackgroundColor="Transparent"
                RowDefinitions="auto,auto"
                RowSpacing="20">
                <dx:DXButton
                    x:Name="CurrentLyricLineBtn"
                    Grid.Row="0"
                    Padding="5"
                    BackgroundColor="Transparent"
                    Clicked="CurrentLyricLine_Clicked"
                    CornerRadius="0"
                    HeightRequest="150"
                    IsVisible="{Binding CurrentPlayingSongView.HasSyncedLyrics}"
                    PressedBackgroundColor="{Binding CurrentPlaySongDominantColor}">


                    <Label
                        x:Name="CurrentLyricLine"
                        Margin="5"
                        BackgroundColor="Transparent"
                        FontAttributes="Bold"
                        FontSize="28"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{Binding CurrentLine.Text}" />

                </dx:DXButton>

                <dx:DXStackLayout Grid.Row="1" ItemSpacing="10">
                    <Label
                        x:Name="SongTitleLabel"
                        FontAttributes="Bold"
                        FontSize="24"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Justify"
                        LineBreakMode="WordWrap"
                        Text="{Binding CurrentPlayingSongView.Title}" />

                    <dx:Chip
                        x:Name="ArtistChip"
                        Grid.Column="0"
                        BorderThickness="0">
                        <dx:Chip.ContentTemplate>
                            <DataTemplate>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    HorizontalOptions="Center"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding CurrentPlayingSongView.OtherArtistsName}"
                                    TextColor="DarkGray" />
                            </DataTemplate>
                        </dx:Chip.ContentTemplate>
                    </dx:Chip>


                    <Grid>
                        <dx:DXBorder
                            BackgroundColor="{Binding CurrentPlaySongDominantColor}"
                            CornerRadius="20"
                            Opacity="1" />
                        <dx:DXStackLayout
                            Padding="15"
                            BorderColor="Transparent"
                            BorderThickness="2"
                            CornerRadius="20"
                            ItemSpacing="5">
                            <FlexLayout JustifyContent="SpaceBetween">
                                <dx:DXStackLayout Orientation="Horizontal">

                                    <dx:Chip
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalOptions="Center"
                                        Icon="shuffle.png"
                                        IconSize="40,40"
                                        IsEnabled="{Binding IsTimestampingInProgress, Converter={converters:BoolToInverseConverter}}"
                                        IsIconVisible="True"
                                        TapCommand="{Binding ToggleShuffleCommand}"
                                        ToolTipProperties.Text="{Binding IsShuffleActive, Converter={converters:BoolToYesNoConverter}, StringFormat='Is Shuffle Active? : {0}'}"
                                        WidthRequest="60">

                                        <dx:Chip.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsShuffleActive}"
                                                TargetType="dx:Chip"
                                                Value="True">
                                                <Setter Property="BorderColor" Value="DarkSlateBlue" />
                                                <Setter Property="BorderThickness" Value="2" />

                                            </DataTrigger>
                                        </dx:Chip.Triggers>

                                    </dx:Chip>

                                    <dx:Chip
                                        x:Name="LyricsChip"
                                        BorderThickness="0"
                                        IconSize="25,25"
                                        LongPress="LyricsChip_LongPress"
                                        Tap="LyricsChip_Tap"
                                        Text="🎙️">
                                        <dx:Chip.Triggers>
                                            <DataTrigger
                                                Binding="{Binding CurrentPlayingSongView.HasLyrics}"
                                                TargetType="dx:Chip"
                                                Value="True">
                                                <Setter Property="TextColor" Value="DarkSlateBlue" />
                                            </DataTrigger>
                                            <DataTrigger
                                                Binding="{Binding CurrentPlayingSongView.HasLyrics}"
                                                TargetType="dx:Chip"
                                                Value="False">
                                                <Setter Property="TextColor" Value="grey" />
                                            </DataTrigger>
                                        </dx:Chip.Triggers>
                                    </dx:Chip>


                                </dx:DXStackLayout>

                                <dx:DXStackLayout Orientation="Horizontal">


                                    <dx:DXToggleButton
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        BorderThickness="0"
                                        CheckedBackgroundColor="Transparent"
                                        CheckedChanging="ShowFrequentlyPlayedExpanderChkBtn_CheckedChanging"
                                        CheckedIconColor="DarkSlateBlue"
                                        Command="{Binding Commands.Show, Source={x:Reference AudioControlCenterSheet}}"
                                        HorizontalOptions="End"
                                        Icon="airbuds.png"
                                        IconColor="DarkSlateBlue"
                                        IconHeight="30"
                                        IconWidth="50"
                                        ShowIcon="True" />
                                    <!--<dx:DXButton
                                        x:Name="AudioMgtButton"
                                        Padding="5"
                                        BackgroundColor="Transparent"
                                        Icon="volume.png"
                                        IconColor="DarkSlateBlue"
                                        IconHeight="30"
                                        IconWidth="30"
                                        TapPressed="AudioMgtButton_TapPressed"
                                        />-->

                                    <dx:DXButton
                                        x:Name="PlaybackChip"
                                        Padding="5"
                                        BackgroundColor="Transparent"
                                        Icon="playlistminimalistic3.png"
                                        IconColor="DarkSlateBlue"
                                        IconHeight="30"
                                        IconWidth="30"
                                        TapPressed="PlaybackChip_TapPressed" />

                                </dx:DXStackLayout>
                            </FlexLayout>

                            <Slider
                                x:Name="TrackProgressSlider"
                                Grid.Column="1"
                                DragCompleted="OnSliderDragCompleted"
                                DragStarted="OnSliderDragStarted"
                                Maximum="{Binding CurrentPlayingSongView.DurationInSeconds}"
                                MaximumTrackColor="{AppThemeBinding Dark=White,
                                                                    Light=Black}"
                                Minimum="0"
                                MinimumTrackColor="DarkSlateBlue"
                                ThumbColor="{Binding CurrentPlaySongDominantColor}"
                                Value="{Binding CurrentTrackPositionSeconds}" />

                            <FlexLayout JustifyContent="SpaceBetween">
                                <dx:Chip BorderThickness="0" Text="{Binding CurrentTrackPositionSecondsTxt}" />

                                <dx:Chip
                                    BorderThickness="0"
                                    IconSize="25,25"
                                    Text="{Binding CurrentPlayingSongView.DurationFormatted}" />

                            </FlexLayout>

                            <Grid BackgroundColor="Transparent" ColumnDefinitions="*,auto,*,auto">
                                <Grid.Resources>
                                    <ResourceDictionary>
                                        <Style TargetType="dx:DXButton">
                                            <Setter Property="IconHeight" Value="45" />
                                            <Setter Property="IconWidth" Value="45" />
                                        </Style>
                                    </ResourceDictionary>
                                </Grid.Resources>

                                <dx:DXButton
                                    Grid.Column="0"
                                    Padding="10"
                                    Background="Transparent"
                                    BackgroundColor="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ToggleRepeatModeCommand}"
                                    HorizontalOptions="Center"
                                    Icon="repeat.png"
                                    IconColor="DarkSlateBlue"
                                    ShowIcon="True"
                                    ToolTipProperties.Text="{Binding CurrentRepeatMode, StringFormat='Current Repeat Mode : {0}'}">
                                    <dx:DXButton.Triggers>
                                        <DataTrigger
                                            Binding="{Binding CurrentRepeatMode}"
                                            TargetType="dx:DXButton"
                                            Value="0">
                                            <Setter Property="BorderColor" Value="DarkSlateBlue" />
                                            <Setter Property="BorderThickness" Value="1" />


                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding CurrentRepeatMode}"
                                            TargetType="dx:DXButton"
                                            Value="1">
                                            <Setter Property="BorderColor" Value="LightBlue" />
                                            <Setter Property="BorderThickness" Value="2" />

                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding CurrentRepeatMode}"
                                            TargetType="dx:DXButton"
                                            Value="2">
                                            <Setter Property="BorderColor" Value="Orange" />
                                            <Setter Property="BorderThickness" Value="2" />

                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding CurrentRepeatMode}"
                                            TargetType="dx:DXButton"
                                            Value="3">
                                            <Setter Property="BorderColor" Value="Red" />
                                            <Setter Property="BorderThickness" Value="2" />

                                        </DataTrigger>
                                    </dx:DXButton.Triggers>

                                </dx:DXButton>


                                <dx:DXStackLayout Grid.Column="1" Orientation="Horizontal">
                                    <dx:DXButton
                                        Padding="10"
                                        BackgroundColor="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding PreviousTrackCommand}"
                                        HorizontalOptions="Center"
                                        Icon="skipprevious.png"
                                        IconColor="DarkSlateBlue"
                                        ShowIcon="True">
                                        <dx:DXButton.CommandParameter>
                                            <x:Boolean>False</x:Boolean>
                                        </dx:DXButton.CommandParameter>
                                    </dx:DXButton>

                                    <dx:DXButton
                                        x:Name="PlayPauseBtn"
                                        Grid.Column="2"
                                        Padding="10"
                                        BackgroundColor="Transparent"
                                        BorderColor="{Binding CurrentPlaySongDominantColor}"
                                        BorderThickness="0"
                                        Command="{Binding PlayPauseToggleCommand}"
                                        HorizontalOptions="Center"
                                        Icon="play.png"
                                        IconColor="DarkSlateBlue"
                                        ShowIcon="True">



                                        <dx:DXButton.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsDimmerPlaying}"
                                                TargetType="dx:DXButton"
                                                Value="true">
                                                <Setter Property="Icon" Value="pause.png" />
                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding IsDimmerPlaying}"
                                                TargetType="dx:DXButton"
                                                Value="false">
                                                <Setter Property="Icon" Value="play.png" />
                                            </DataTrigger>
                                        </dx:DXButton.Triggers>
                                    </dx:DXButton>

                                    <dx:DXButton
                                        Grid.Column="3"
                                        Padding="10"
                                        BackgroundColor="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding NextTrackCommand}"
                                        HorizontalOptions="Center"
                                        Icon="skipnext.png"
                                        IconColor="DarkSlateBlue"
                                        ShowIcon="True">
                                        <dx:DXButton.CommandParameter>
                                            <x:Boolean>False</x:Boolean>
                                        </dx:DXButton.CommandParameter>
                                    </dx:DXButton>
                                </dx:DXStackLayout>
                                <dx:DXStackLayout
                                    Grid.Column="2"
                                    HorizontalOptions="End"
                                    Orientation="Horizontal">

                                    <dx:DXButton
                                        Padding="10"
                                        BackgroundColor="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding AddFavoriteRatingToSongCommand}"
                                        CommandParameter="{Binding CurrentPlayingSongView}"
                                        HorizontalOptions="End"
                                        Icon="heart.png"
                                        IconColor="DarkSlateBlue"
                                        ShowIcon="True">
                                        <dx:DXButton.Triggers>
                                            <DataTrigger
                                                Binding="{Binding CurrentPlayingSongView.IsFavorite}"
                                                TargetType="dx:DXButton"
                                                Value="true">
                                                <Setter Property="Icon" Value="heartlock.png" />
                                            </DataTrigger>
                                            <DataTrigger
                                                Binding="{Binding CurrentPlayingSongView.IsFavorite}"
                                                TargetType="dx:DXButton"
                                                Value="false">
                                                <Setter Property="Icon" Value="heart.png" />
                                            </DataTrigger>
                                        </dx:DXButton.Triggers>
                                    </dx:DXButton>


                                </dx:DXStackLayout>


                            </Grid>

                        </dx:DXStackLayout>

                    </Grid>




                </dx:DXStackLayout>
            </Grid>
        </dx:DXExpander>


        <!--  THE ULTIMATE AUDIO CONTROL CENTER  -->
        <dx:BottomSheet
            x:Name="AudioControlCenterSheet"
            AllowDismiss="True"
            AllowedState="HalfExpanded"
            BackgroundColor="{AppThemeBinding Light=#F8F9FA,
                                              Dark=#1E1E2C}"
            CornerRadius="25"
            HalfExpandedRatio="0.85"
            StateChanged="AudioControlCenterSheet_StateChanged">

            <dx:BottomSheet.Resources>
                <ResourceDictionary>
                    <Style TargetType="Label">
                        <Setter Property="TextColor" Value="{AppThemeBinding Light=#424242, Dark=#EEEEEE}" />
                    </Style>
                    <Style TargetType="dx:ChipGroup">
                        <Setter Property="ChipTextColor" Value="{AppThemeBinding Light=#424242, Dark=White}" />
                    </Style>
                    <!--  Sleek styling for section headers  -->
                    <Style x:Key="HeaderLabel" TargetType="Label">
                        <Setter Property="FontAttributes" Value="Bold" />
                        <Setter Property="FontSize" Value="16" />
                        <Setter Property="TextColor" Value="DarkSlateBlue" />
                        <Setter Property="Margin" Value="0,10,0,5" />
                    </Style>
                </ResourceDictionary>
            </dx:BottomSheet.Resources>

            <dx:TabView
                BackgroundColor="Transparent"
                HeaderPanelBackgroundColor="Transparent"
                HeaderPanelPosition="Top"
                ItemHeaderTextColor="{AppThemeBinding Light=#333333,
                                                      Dark=White}">

                <!--  ==========================================  -->
                <!--  TAB 1: MASTER FX & MODES  -->
                <!--  ==========================================  -->
                <dx:TabViewItem HeaderText="Master FX">
                    <dx:DXScrollView IsScrollBarVisible="False">
                        <dx:DXStackLayout Padding="15" ItemSpacing="20">

                            <!--  VIBE MODES (Nightcore, Slowed, etc.)  -->
                            <dx:DXStackLayout ItemSpacing="5">
                                <Label Style="{StaticResource HeaderLabel}" Text="VIBE MODES" />
                                <dx:ChoiceChipGroup
                                    ChipSelectedBackgroundColor="DarkSlateBlue"
                                    ChipSelectedTextColor="White"
                                    SelectedIndex="{Binding SelectedPlaybackModeIndex, Mode=TwoWay}">
                                    <dx:ChoiceChipGroup.Chips>
                                        <dx:Chip Text="Normal" />
                                        <dx:Chip Text="Nightcore" />
                                        <dx:Chip Text="Slowed" />
                                        <dx:Chip Text="Slowed + Reverb" />
                                    </dx:ChoiceChipGroup.Chips>
                                </dx:ChoiceChipGroup>
                            </dx:DXStackLayout>

                            <!--  STUDIO POLISH  -->
                            <dx:DXStackLayout ItemSpacing="5">
                                <Label Style="{StaticResource HeaderLabel}" Text="STUDIO POLISH" />
                                <dx:DXBorder
                                    Padding="15"
                                    BorderColor="{AppThemeBinding Light=#E0E0E0,
                                                                  Dark=#333344}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid
                                        ColumnDefinitions="*, Auto"
                                        RowDefinitions="*,*"
                                        RowSpacing="15">
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Text="Smart Master (Hi-Fi)"
                                            VerticalOptions="Center" />
                                        <dx:DXSwitch
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            CheckedThumbColor="DarkSlateBlue"
                                            IsChecked="{Binding IsSmartMasterEnabled}" />

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Text="Vocal Compressor"
                                            VerticalOptions="Center" />
                                        <dx:DXSwitch
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            CheckedThumbColor="DarkSlateBlue"
                                            IsChecked="{Binding IsCompressorEnabled}" />
                                    </Grid>
                                </dx:DXBorder>
                            </dx:DXStackLayout>

                            <!--  AMBIENCE (Rain/Vinyl)  -->
                            <dx:DXStackLayout ItemSpacing="5">
                                <Label Style="{StaticResource HeaderLabel}" Text="AMBIENCE (STUDY MODE)" />
                                <dx:DXBorder
                                    Padding="15"
                                    BorderColor="{AppThemeBinding Light=#E0E0E0,
                                                                  Dark=#333344}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid
                                        ColumnDefinitions="*, Auto"
                                        RowDefinitions="Auto, Auto"
                                        RowSpacing="10">
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Text="Enable Background Noise"
                                            VerticalOptions="Center" />
                                        <dx:DXSwitch
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            CheckedThumbColor="DarkSlateBlue"
                                            IsChecked="{Binding IsAmbienceEnabled}" />

                                        <dx:DXSlider
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            IsEnabled="{Binding IsAmbienceEnabled}"
                                            MaxValue="1"
                                            MinValue="0"
                                            Value="{Binding AmbienceVolume}" />
                                    </Grid>
                                </dx:DXBorder>
                            </dx:DXStackLayout>

                            <!--  EXPORT REMIX (Save to WAV)  -->
                            <dx:DXStackLayout ItemSpacing="5">
                                <Label Style="{StaticResource HeaderLabel}" Text="EXPORT" />
                                <dx:DXButton
                                    BackgroundColor="MediumPurple"
                                    Command="{Binding ExportRemixCommand}"
                                    Content="Save Remix to Audio File"
                                    CornerRadius="10"
                                    Icon="save.png"
                                    TextColor="White" />
                            </dx:DXStackLayout>

                        </dx:DXStackLayout>
                    </dx:DXScrollView>
                </dx:TabViewItem>

                <!--  ==========================================  -->
                <!--  TAB 2: 10-BAND EQUALIZER  -->
                <!--  ==========================================  -->
                <dx:TabViewItem HeaderText="Equalizer">
                    <Grid Padding="15" RowDefinitions="Auto, *">

                        <Grid
                            Grid.Row="0"
                            Margin="0,0,0,20"
                            ColumnDefinitions="*, Auto">
                            <Label
                                Grid.Column="0"
                                Style="{StaticResource HeaderLabel}"
                                Text="GRAPHIC EQUALIZER"
                                VerticalOptions="Center" />
                            <dx:DXSwitch
                                Grid.Column="1"
                                CheckedThumbColor="DarkSlateBlue"
                                IsChecked="{Binding IsEqEnabled}" />
                        </Grid>

                        <!--  FIXED: Used a HorizontalStackLayout for a true scrolling mixing desk  -->
                        <ScrollView
                            Grid.Row="1"
                            IsEnabled="{Binding IsEqEnabled}"
                            Orientation="Horizontal"
                            VerticalOptions="Fill">
                            <HorizontalStackLayout Padding="10,0" Spacing="25">
                                <!--  We use Standard MAUI Sliders rotated -90 degrees for vertical EQ faders!  -->

                                <!--  Band 1: Sub Bass  -->
                                <VerticalStackLayout Spacing="10" WidthRequest="40">
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="+12"
                                        TextColor="Gray" />
                                    <!--  Rotate MAUI slider to make it a vertical fader  -->
                                    <dx:DXSlider
                                        HeightRequest="40"
                                        MaxValue="12"
                                        MinValue="-12"
                                        Rotation="-90"
                                        TranslationX="-55"
                                        TranslationY="55"
                                        WidthRequest="150"
                                        Value="{Binding EqBand0}" />
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="-12"
                                        TextColor="Gray"
                                        TranslationY="110" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="31 Hz"
                                        TranslationY="110" />
                                </VerticalStackLayout>

                                <!--  Band 2: Bass  -->
                                <VerticalStackLayout Spacing="10" WidthRequest="40">
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="+12"
                                        TextColor="Gray" />
                                    <dx:DXSlider
                                        HeightRequest="40"
                                        MaxValue="12"
                                        MinValue="-12"
                                        Rotation="-90"
                                        TranslationX="-55"
                                        TranslationY="55"
                                        WidthRequest="150"
                                        Value="{Binding EqBand1}" />
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="-12"
                                        TextColor="Gray"
                                        TranslationY="110" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="62 Hz"
                                        TranslationY="110" />
                                </VerticalStackLayout>

                                <!--  Band 3: Low Mid  -->
                                <VerticalStackLayout Spacing="10" WidthRequest="40">
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="+12"
                                        TextColor="Gray" />
                                    <dx:DXSlider
                                        HeightRequest="40"
                                        MaxValue="12"
                                        MinValue="-12"
                                        Rotation="-90"
                                        TranslationX="-55"
                                        TranslationY="55"
                                        WidthRequest="150"
                                        Value="{Binding EqBand2}" />
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="-12"
                                        TextColor="Gray"
                                        TranslationY="110" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="125 Hz"
                                        TranslationY="110" />
                                </VerticalStackLayout>

                                <!--  Band 4  -->
                                <VerticalStackLayout Spacing="10" WidthRequest="40">
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="+12"
                                        TextColor="Gray" />
                                    <dx:DXSlider
                                        HeightRequest="40"
                                        MaxValue="12"
                                        MinValue="-12"
                                        Rotation="-90"
                                        TranslationX="-55"
                                        TranslationY="55"
                                        WidthRequest="150"
                                        Value="{Binding EqBand3}" />
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="-12"
                                        TextColor="Gray"
                                        TranslationY="110" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="250 Hz"
                                        TranslationY="110" />
                                </VerticalStackLayout>

                                <!--  Band 5  -->
                                <VerticalStackLayout Spacing="10" WidthRequest="40">
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="+12"
                                        TextColor="Gray" />
                                    <dx:DXSlider
                                        HeightRequest="40"
                                        MaxValue="12"
                                        MinValue="-12"
                                        Rotation="-90"
                                        TranslationX="-55"
                                        TranslationY="55"
                                        WidthRequest="150"
                                        Value="{Binding EqBand4}" />
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="-12"
                                        TextColor="Gray"
                                        TranslationY="110" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="500 Hz"
                                        TranslationY="110" />
                                </VerticalStackLayout>

                                <!--  Band 6  -->
                                <VerticalStackLayout Spacing="10" WidthRequest="40">
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="+12"
                                        TextColor="Gray" />
                                    <dx:DXSlider
                                        HeightRequest="40"
                                        MaxValue="12"
                                        MinValue="-12"
                                        Rotation="-90"
                                        TranslationX="-55"
                                        TranslationY="55"
                                        WidthRequest="150"
                                        Value="{Binding EqBand5}" />
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="-12"
                                        TextColor="Gray"
                                        TranslationY="110" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="1 kHz"
                                        TranslationY="110" />
                                </VerticalStackLayout>

                                <!--  Band 7  -->
                                <VerticalStackLayout Spacing="10" WidthRequest="40">
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="+12"
                                        TextColor="Gray" />
                                    <dx:DXSlider
                                        HeightRequest="40"
                                        MaxValue="12"
                                        MinValue="-12"
                                        Rotation="-90"
                                        TranslationX="-55"
                                        TranslationY="55"
                                        WidthRequest="150"
                                        Value="{Binding EqBand6}" />
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="-12"
                                        TextColor="Gray"
                                        TranslationY="110" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="2 kHz"
                                        TranslationY="110" />
                                </VerticalStackLayout>

                                <!--  Band 8  -->
                                <VerticalStackLayout Spacing="10" WidthRequest="40">
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="+12"
                                        TextColor="Gray" />
                                    <dx:DXSlider
                                        HeightRequest="40"
                                        MaxValue="12"
                                        MinValue="-12"
                                        Rotation="-90"
                                        TranslationX="-55"
                                        TranslationY="55"
                                        WidthRequest="150"
                                        Value="{Binding EqBand7}" />
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="-12"
                                        TextColor="Gray"
                                        TranslationY="110" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="4 kHz"
                                        TranslationY="110" />
                                </VerticalStackLayout>

                                <!--  Band 9  -->
                                <VerticalStackLayout Spacing="10" WidthRequest="40">
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="+12"
                                        TextColor="Gray" />
                                    <dx:DXSlider
                                        HeightRequest="40"
                                        MaxValue="12"
                                        MinValue="-12"
                                        Rotation="-90"
                                        TranslationX="-55"
                                        TranslationY="55"
                                        WidthRequest="150"
                                        Value="{Binding EqBand8}" />
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="-12"
                                        TextColor="Gray"
                                        TranslationY="110" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="8 kHz"
                                        TranslationY="110" />
                                </VerticalStackLayout>

                                <!--  Band 10: Air/Sparkle  -->
                                <VerticalStackLayout Spacing="10" WidthRequest="40">
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="+12"
                                        TextColor="Gray" />
                                    <dx:DXSlider
                                        HeightRequest="40"
                                        MaxValue="12"
                                        MinValue="-12"
                                        Rotation="-90"
                                        TranslationX="-55"
                                        TranslationY="55"
                                        WidthRequest="150"
                                        Value="{Binding EqBand9}" />
                                    <Label
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="-12"
                                        TextColor="Gray"
                                        TranslationY="110" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HorizontalTextAlignment="Center"
                                        Text="16 kHz"
                                        TranslationY="110" />
                                </VerticalStackLayout>

                            </HorizontalStackLayout>
                        </ScrollView>
                    </Grid>
                </dx:TabViewItem>

                <!--  ==========================================  -->
                <!--  TAB 3: METERS & VISUALIZER (NEW!)  -->
                <!--  ==========================================  -->
                <dx:TabViewItem HeaderText="Visuals">
                    <dx:DXStackLayout Padding="15" ItemSpacing="20">

                        <!--  LIVE VU METERS (L/R Peak Levels)  -->
                        <dx:DXStackLayout ItemSpacing="5">
                            <Label Style="{StaticResource HeaderLabel}" Text="MASTER OUTPUT LEVELS" />
                            <dx:DXBorder
                                Padding="15"
                                BorderColor="{AppThemeBinding Light=#E0E0E0,
                                                              Dark=#333344}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <Grid
                                    ColumnDefinitions="Auto, *, Auto"
                                    RowDefinitions="Auto, Auto"
                                    RowSpacing="15">

                                    <!--  Left Channel  -->
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        FontAttributes="Bold"
                                        Text="L" />
                                    <ProgressBar
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Progress="{Binding LeftVuLevel}"
                                        ProgressColor="SpringGreen"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        FontSize="12"
                                        Text="{Binding LeftVuDb, StringFormat='{0:F1} dB'}" />

                                    <!--  Right Channel  -->
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        FontAttributes="Bold"
                                        Text="R" />
                                    <ProgressBar
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Progress="{Binding RightVuLevel}"
                                        ProgressColor="SpringGreen"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        FontSize="12"
                                        Text="{Binding RightVuDb, StringFormat='{0:F1} dB'}" />
                                </Grid>
                            </dx:DXBorder>
                        </dx:DXStackLayout>

                        <!--  SPECTRUM ANALYZER (DevExpress Chart Placeholder)  -->
                        <dx:DXStackLayout ItemSpacing="5" VerticalOptions="Fill">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label
                                    Grid.Column="0"
                                    Style="{StaticResource HeaderLabel}"
                                    Text="SPECTRUM ANALYZER" />
                                <dx:DXSwitch
                                    Grid.Column="1"
                                    CheckedThumbColor="DarkSlateBlue"
                                    IsChecked="{Binding IsVisualizerEnabled}" />
                            </Grid>
                            <dx:DXBorder
                                Padding="5"
                                BackgroundColor="#0A0A12"
                                CornerRadius="12"
                                HeightRequest="150">
                                <!--  If you have DevExpress Charts installed, you bind the Spectrum array here!  -->
                                <!--  If not, it's a sleek black display box waiting for SkiaSharp.  -->
                                <Label
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding IsVisualizerEnabled}"
                                    Text="[ Visualizer Active ]"
                                    TextColor="SpringGreen"
                                    VerticalOptions="Center" />
                            </dx:DXBorder>
                        </dx:DXStackLayout>

                    </dx:DXStackLayout>
                </dx:TabViewItem>

                <!--  ==========================================  -->
                <!--  TAB 4: ROUTING & MIXING  -->
                <!--  ==========================================  -->
                <dx:TabViewItem HeaderText="Routing">
                    <dx:DXScrollView>
                        <dx:DXStackLayout Padding="15" ItemSpacing="25">

                            <!--  Volume & Mute  -->
                            <dx:DXStackLayout ItemSpacing="5">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource HeaderLabel}"
                                        Text="MASTER VOLUME"
                                        VerticalOptions="Center" />
                                    <dx:DXButton
                                        Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        Command="{Binding ToggleMuteCommand}"
                                        Icon="volumemute.png" />
                                </Grid>
                                <dx:DXSlider
                                    MaxValue="1"
                                    MinValue="0"
                                    Value="{Binding DeviceVolumeLevel}" />
                            </dx:DXStackLayout>

                            <!--  DJ Crossfade  -->
                            <dx:DXStackLayout ItemSpacing="5">
                                <Label Style="{StaticResource HeaderLabel}" Text="DJ CROSSFADER" />
                                <dx:DXBorder
                                    Padding="15,10"
                                    BorderColor="{AppThemeBinding Light=#E0E0E0,
                                                                  Dark=#333344}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <dx:DXStackLayout ItemSpacing="0">
                                        <dx:DXSlider
                                            MaxValue="1"
                                            MinValue="0"
                                            Value="{Binding CrossfadeBalance}" />
                                        <Grid ColumnDefinitions="*,*">
                                            <Label
                                                Grid.Column="0"
                                                FontSize="12"
                                                Text="Track A"
                                                TextColor="Gray" />
                                            <Label
                                                Grid.Column="1"
                                                FontSize="12"
                                                HorizontalTextAlignment="End"
                                                Text="Track B"
                                                TextColor="Gray" />
                                        </Grid>
                                    </dx:DXStackLayout>
                                </dx:DXBorder>
                            </dx:DXStackLayout>

                            <!--  Output Device Selection  -->
                            <dx:DXStackLayout ItemSpacing="5">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label
                                        Grid.Column="0"
                                        Style="{StaticResource HeaderLabel}"
                                        Text="AUDIO HARDWARE"
                                        VerticalOptions="Center" />
                                    <dx:DXButton
                                        Grid.Column="1"
                                        BackgroundColor="Transparent"
                                        Command="{Binding LoadAllAudioDevicesCommand}"
                                        Icon="refresh.png" />
                                </Grid>

                                <dx:DXBorder
                                    BorderColor="{AppThemeBinding Light=#E0E0E0,
                                                                  Dark=#333344}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <dx:DXCollectionView
                                        HeightRequest="180"
                                        ItemsSource="{Binding AvailableDevices}"
                                        SelectedItem="{Binding SelectedAudioDevice, Mode=TwoWay}"
                                        SelectionMode="Single">
                                        <dx:DXCollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="models:AudioOutputDevice">
                                                <Grid Padding="15,10" ColumnDefinitions="Auto, *">
                                                    <!--  Assuming you have an icon named speaker.png  -->
                                                    <dx:DXImage
                                                        Grid.Column="0"
                                                        Margin="0,0,15,0"
                                                        HeightRequest="20"
                                                        Source="speaker.png"
                                                        TintColor="{AppThemeBinding Light=Black,
                                                                                    Dark=White}"
                                                        VerticalOptions="Center"
                                                        WidthRequest="20" />
                                                    <Label
                                                        Grid.Column="1"
                                                        FontSize="14"
                                                        Text="{Binding Name}"
                                                        VerticalOptions="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </dx:DXCollectionView.ItemTemplate>
                                    </dx:DXCollectionView>
                                </dx:DXBorder>
                            </dx:DXStackLayout>

                        </dx:DXStackLayout>
                    </dx:DXScrollView>
                </dx:TabViewItem>

            </dx:TabView>
        </dx:BottomSheet>

    </Grid>
</ContentView>