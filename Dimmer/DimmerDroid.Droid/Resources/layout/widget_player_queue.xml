<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E61A1826"
    android:orientation="vertical"
    android:padding="12dp">

	<!-- Reuse exact same player header -->
	<include layout="@layout/widget_player_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

	<TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:text="UP NEXT"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

	<ListView
        android:id="@+id/widget_queue_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#22FFFFFF"
        android:dividerHeight="1dp" />

	<TextView
        android:id="@+id/widget_queue_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="Queue is empty"
        android:textColor="#88FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>