<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#E61A1826"
    android:orientation="vertical"
    android:padding="8dp">

	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

		<ImageView
            android:id="@+id/widget_cover"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_info_details" />

		<LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

			<TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/notPlaying"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

			<TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Dimmer"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
		</LinearLayout>

		<ImageButton
            android:id="@+id/widget_btn_prev"
            android:layout_width="34dp"
android:contentDescription="BtnPrev"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF" />

		<ImageButton
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_play"
android:contentDescription="PlayPause"
            android:tint="#FFFFFF" />

		<ImageButton
            android:id="@+id/widget_btn_next"
            android:layout_width="34dp"
            android:contentDescription="btnNext"
            android:layout_height="34dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFF" />
	</LinearLayout>

	<ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="#6C63FF" />
</LinearLayout>